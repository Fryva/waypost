{
  "id": "codebuddy",
  "name": "CodeBuddy Code (腾讯云代码助手)",
  "vendor": "Tencent",
  "home": "https://www.codebuddy.ai",
  "docs": "https://www.codebuddy.ai/docs/cli/sub-agents",
  "confidence": "documented",
  "detect": [".codebuddy"],
  "env": ["CODEBUDDY_CODE", "CODEBUDDY_CLI"],
  "instructions": ["AGENTS.md", "CLAUDE.md"],
  "invoke": "delegate to the `mps-<role>` sub-agent",
  "roles": {
    "shape": "frontmatter-md",
    "dir": ".codebuddy/agents",
    "file": "{prefix}{role}.md",
    "model": { "tiers": {} },
    "tools": { "style": "comma" },
    "fields": [
      ["name", "{prefix}{role}"],
      ["description", "{description}"],
      ["model", "{model}"],
      ["effort", "{effort}"],
      ["tools", "{tools}"],
      ["disallowedTools", "{denied_tools}"]
    ]
  },
  "notes": "Sub-agents are Markdown + YAML frontmatter in .codebuddy/agents/ (user level ~/.codebuddy/agents/); tools are comma-separated and the frontmatter is close to Claude Code's, including `effort`."
}
