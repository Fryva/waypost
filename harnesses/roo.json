{
  "id": "roo",
  "name": "Roo Code",
  "vendor": "Roo Code",
  "home": "https://roocode.com",
  "confidence": "documented",
  "docs": "https://docs.roocode.com/features/custom-modes",
  "detect": [
    ".roomodes",
    ".roo"
  ],
  "env": [
    "ROO_CODE",
    "ROO_AGENT"
  ],
  "instructions": [
    ".roo/rules/mps-agents.md",
    "AGENTS.md"
  ],
  "invoke": "switch to the `mps-<role>` mode",
  "roles": {
    "shape": "aggregate-json",
    "file": ".roomodes",
    "array": "customModes",
    "key": "slug",
    "model": false,
    "entry": {
      "slug": "{prefix}{role}",
      "name": "mps {role}",
      "roleDefinition": "{body}",
      "groups": [
        "read",
        "command"
      ]
    }
  },
  "notes": "Roo keeps every custom mode in one file, so mps merges into it: entries whose slug starts with mps- are ours, everything else is left untouched."
}
