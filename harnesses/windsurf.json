{
  "id": "windsurf",
  "name": "Windsurf",
  "vendor": "Cognition",
  "home": "https://windsurf.com",
  "confidence": "documented",
  "docs": "https://docs.windsurf.com/windsurf/cascade/workflows",
  "detect": [
    ".windsurf",
    ".windsurfrules"
  ],
  "env": [
    "WINDSURF_AGENT",
    "WINDSURF_SESSION"
  ],
  "instructions": [
    ".windsurf/rules/mps-agents.md",
    "AGENTS.md"
  ],
  "invoke": "/mps-<role> (workflow), or paste `mps agents show <role>` into a fresh conversation",
  "roles": {
    "shape": "prompt-md",
    "dir": ".windsurf/workflows",
    "file": "{prefix}{role}.md",
    "model": false,
    "fields": [
      [
        "description",
        "{description}"
      ]
    ]
  },
  "notes": "Workflows are invoked as slash commands; they run in the current conversation, so the fresh-context contract is on the caller."
}
