{
  "id": "codex",
  "name": "Codex CLI",
  "vendor": "OpenAI",
  "home": "https://developers.openai.com/codex/cli",
  "confidence": "documented",
  "docs": "https://developers.openai.com/codex/cli",
  "detect": [
    ".codex"
  ],
  "env": [
    "CODEX_SANDBOX",
    "CODEX_HOME",
    "CODEX_SANDBOX_NETWORK_DISABLED"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "invoke": "/mps-<role> <target>, or codex exec \"$(mps agents show <role>) <target>\"",
  "after_install": "Codex reads prompts from ~/.codex/prompts — copy them there to get slash commands:\n  cp .codex/prompts/mps-*.md ~/.codex/prompts/",
  "roles": {
    "shape": "prompt-md",
    "dir": ".codex/prompts",
    "file": "{prefix}{role}.md",
    "model": false,
    "model_note": "A Codex prompt file carries no model — the model belongs to the Codex session.",
    "fields": [
      [
        "description",
        "{description}"
      ],
      [
        "argument-hint",
        "<file or topic to work on>"
      ]
    ]
  }
}
