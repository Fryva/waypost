{
  "id": "cline",
  "name": "Cline",
  "vendor": "Cline",
  "home": "https://cline.bot",
  "confidence": "documented",
  "docs": "https://docs.cline.bot/features/slash-commands/workflows",
  "detect": [
    ".clinerules"
  ],
  "env": [
    "CLINE_AGENT"
  ],
  "instructions": [
    ".clinerules/mps-agents.md",
    "AGENTS.md"
  ],
  "invoke": "/mps-<role>.md (workflow), or paste `mps agents show <role>` into a new task",
  "roles": {
    "shape": "prompt-md",
    "dir": ".clinerules/workflows",
    "file": "{prefix}{role}.md",
    "model": false,
    "fields": [
      [
        "description",
        "{description}"
      ]
    ]
  },
  "notes": "Cline workflows live beside the rules and are invoked by filename."
}
