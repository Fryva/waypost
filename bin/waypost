#!/usr/bin/env node
// waypost — Waypost: harness-agnostic project store & verified loop.
// One entry point for Claude Code, Codex and OpenCode. The dispatcher owns
// every write to disk; the scripts under scripts/ stay pure compute printing
// JSON, which is what lets doctor re-run them to detect drift.
//
// Subcommands: see help() at the bottom, or `waypost help`.

import { resolve, dirname, join, sep, basename, relative } from "node:path";
import { fileURLToPath } from "node:url";
import {
  existsSync, mkdirSync, writeFileSync, readFileSync, readdirSync, statSync, lstatSync, unlinkSync, rmSync,
  statfsSync, appendFileSync,
} from "node:fs";
import { spawnSync, spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { homedir, hostname, setPriority, uptime as osUptime, constants as osConstants } from "node:os";
import {
  parseFrontmatter, isInsideVault, writeFileAtomic, sessionId, sessionIdFlag, storyRefOf, expandHome,
  storedVaultPath, resolveVaultPath, bindingInfo, readConfig as readConfigLib, isLinkedWorktree, worktreeTag,
  machineStateDir, askYesNo,
} from "../scripts/lib.mjs";

// Captured before main() (below) pins WAYPOST_SESSION_ID, WAYPOST_HARNESS and
// WAYPOST_PROC (the harness process) onto process.env for THIS process's own
// labelling (heartbeat, commit trailers): `run --heavy`'s spawned COMMAND must
// not silently inherit an identity this process only invented for itself —
// see runHeavy()'s use of these.
const INHERITED_SESSION_ID = process.env.WAYPOST_SESSION_ID;
const INHERITED_HARNESS = process.env.WAYPOST_HARNESS;
const INHERITED_PROC = process.env.WAYPOST_PROC;

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const SCRIPT = (name) => join(ROOT, "scripts", `${name}.mjs`);
const VERSION = (() => {
  try { return JSON.parse(readFileSync(join(ROOT, "package.json"), "utf8")).version; }
  catch { return "0.0.0"; }
})();

function fail(msg) {
  process.stderr.write(`waypost: ${msg}\n`);
  process.exit(1);
}

// Run a core script. `capture` pipes stdout so the dispatcher can act on the
// JSON; otherwise the child owns the terminal. Either way the child's exit
// code is ours — a harness scripting `waypost doctor && ...` must see failures.
//
// The tool root is the tree this executable belongs to, always: the children
// get WAYPOST_HOME=ROOT even when the caller exported something else. A
// dispatcher validating layouts against its own tree while its scripts read
// templates from another (O-4) is two versions of the tool in one command
// line. WAYPOST_HOME still means "tool root" for a script run directly.
function run(script, args = [], { capture = false } = {}) {
  const r = spawnSync(process.execPath, [SCRIPT(script), ...args], {
    encoding: "utf8",
    stdio: capture ? ["inherit", "pipe", "inherit"] : "inherit",
    env: { ...process.env, WAYPOST_HOME: ROOT },
  });
  if (r.error) fail(`${script}: ${r.error.message}`);
  if (r.status !== 0) process.exit(r.status ?? 1);
  return capture ? r.stdout : "";
}

function runJson(script, args = []) {
  const out = run(script, args, { capture: true });
  try {
    return JSON.parse(out);
  } catch {
    process.stdout.write(out);
    fail(`${script}: expected JSON on stdout`);
  }
}

function projectRoot() {
  return process.env.WAYPOST_PROJECT_DIR || process.env.CLAUDE_PROJECT_DIR || process.cwd();
}

// The binding, wherever it comes from: this project's own .waypost/, or, in a
// linked worktree without one, the main worktree's (ADR-0010).
function configPath() {
  return bindingInfo().path;
}

// null means "not bound" — the right next step is `waypost bind`/`waypost setup`. A
// config that exists but does not parse is a different, louder problem: left
// indistinguishable from "not bound", `waypost setup` would silently rebind over
// it and discard whatever settings the file still held.
function readConfig() {
  try { return readConfigLib(); }
  catch (e) { fail(`config exists but is unreadable: ${configPath()}: ${e.message}`); }
}

// Options that take a value. Everything else starting with `--` is a boolean,
// which is what separates `draft --write adr "T"` (three tokens, one flag) from
// `draft --lang ru adr "T"` (four tokens, one flag with a value). Guessing
// "the token after any flag is its value" ate the first positional whenever a
// boolean flag was written before it.
const VALUED = new Set(["--harness", "--layout", "--lang", "--only", "--id",
  "--budget", "--project", "--since", "--for", "--kind", "--limit", "--message",
  "--story", "--merge", "--session", "--provider", "--older-than", "--wait", "--release", "--reason"]);

// The literal `--` stops flag parsing, same as most POSIX CLIs: everything
// after it is positional even if it is spelled like a flag (`waypost search --
// --literal`). Only tokens before it are eligible to be a flag name or a
// flag's value.
function splitAtTerminator(args) {
  const i = args.indexOf("--");
  return i === -1 ? { head: args, tail: [] } : { head: args.slice(0, i), tail: args.slice(i + 1) };
}

function flag(args, name) {
  const { head } = splitAtTerminator(args);
  return head.includes(name) || head.some((a) => a === `${name}=true`);
}

function opt(args, name, dflt = null) {
  const { head } = splitAtTerminator(args);
  const i = head.indexOf(name);
  if (i !== -1) {
    const v = head[i + 1];
    if (v === undefined) fail(`${name} requires a value`);
    return v;
  }
  const eq = head.find((a) => a.startsWith(`${name}=`));
  return eq ? eq.slice(name.length + 1) : dflt;
}

function positionals(args) {
  const { head, tail } = splitAtTerminator(args);
  const out = [];
  for (let i = 0; i < head.length; i++) {
    const a = head[i];
    if (a.startsWith("--")) { if (VALUED.has(a)) i++; continue; }
    out.push(a);
  }
  out.push(...tail);
  return out;
}

// ─── setup: one command that leaves the project ready ──────────────────
//
// Reading a manual to configure a tool is time the tool was supposed to save.
// Everything here is derivable: where the vault goes, which harnesses this
// project uses, which repairs are mechanical. So derive it, do it, and print
// what happened — with --dry-run for anyone who wants to look first.
async function handleSetup(args) {
  const dry = flag(args, "--dry-run");
  const say = (l) => process.stdout.write(l + "\n");
  const step = (label, fn) => { if (dry) { say(`would ${label}`); return null; } say(label); return fn(); };

  const existing = readConfig();
  const vault = opt(args, "--vault") || (existing && existing.vault_path) || guessVault();
  say(`project ${projectRoot()}`);

  if (!existing || !existing.vault_path) {
    step(`bind vault ${vault}`, () => handleBind([vault, ...passThrough(args, ["--layout", "--lang"])]));
  } else {
    say(`vault  ${existing.vault_path} (already bound)`);
    step("scaffold any missing layout folders", () => handleScaffold([]));
  }

  const harnesses = opt(args, "--harness");
  const detected = detectedHarnesses();
  if (harnesses || detected.length) {
    step(`install roles for ${harnesses || detected.join(", ")}`,
      () => run("agents", ["install", ...(harnesses ? ["--harness", harnesses] : [])]));
    step(`install skills for ${harnesses || detected.join(", ")}`,
      () => run("skills", ["install", ...(harnesses ? ["--harness", harnesses] : [])]));
    step("register the routing block", () => run("agents", ["register"]));
  } else {
    say("no harness detected — run `waypost agents install --harness <id>` once you pick one");
    say("  (`waypost harnesses --all` lists what is supported)");
  }

  // WP-17, the discovery story: the machine and project profiles, under the
  // same refresh rule `waypost profile` uses (missing, older than 30 days, or
  // --refresh — never forced just because setup is running). Discovery is a
  // PATH stat plus a handful of ≤3s subprocess calls, not heavy work in the
  // WP-18 sense, so it takes no machine-wide slot; the machine audit that
  // does is a later story's step, not this one.
  //
  // --dry-run reports what refreshing WOULD do (read-only: load the existing
  // profiles, if any, and say whether each is due) rather than the generic
  // `step()` one-liner every other step uses — "would discover" alone never
  // says whether a fresh profile would be kept or a stale one rebuilt.
  // Set inside the discovery step below when it actually refreshes the
  // machine profile THIS run — the audit step (last, below) reads it to
  // decide whether the machine is its to audit at all this time.
  let machineRefreshedThisRun = false;

  if (dry) {
    say("would discover tools and ecosystems");
    const discovery = await import(`file://${SCRIPT("discovery")}`);
    const presence = await import(`file://${SCRIPT("presence")}`);
    const home = homedir();
    const host = presence.hostSlug();
    const machinePath = discovery.machineProfilePath({ home, host });
    const load = (p) => {
      if (!existsSync(p)) return null;
      try { return JSON.parse(readFileSync(p, "utf8")); } catch { return null; }
    };
    const describe = (label, prof) => discovery.needsRefresh(prof, {})
      ? `  would refresh the ${label} profile`
      : `  would keep the ${label} profile (generated ${prof.generated_at})`;
    say(describe("machine", load(machinePath)));
    // Item 6: a project profile at $HOME would write into the user's home
    // directory itself — the same reasoning `waypost size --project`
    // already refuses ($HOME as a project root, scripts/sizes.mjs).
    if (resolve(projectRoot()) === resolve(home)) {
      say("  no project here — machine profile only");
    } else {
      const projectPath = discovery.projectProfilePath({ projectRoot: projectRoot(), host });
      say(describe("project", load(projectPath)));
    }
  } else {
    await step("discover tools and ecosystems", async () => {
      // A discovery failure (an unwritable machine-state directory, a
      // registry that fails to load, …) must not take the rest of setup
      // down with it — the vault is already bound, roles already installed,
      // and the repair step below still matters. Reported inline instead.
      try {
        const r = await refreshProfiles({ force: false });
        machineRefreshedThisRun = Boolean(r.machineRefreshed);
        say(`  machine  ${r.machineRefreshed ? "refreshed" : "kept"} — ${r.machine.tools.length} tool(s), ${r.machine.caches.length} cache path(s)`);
        if (r.noProject) say("  project  no project here — machine profile only");
        else say(`  project  ${r.projectRefreshed ? "refreshed" : "kept"} — ${r.project.ecosystems.length} ecosystem(s)`);
      } catch (e) {
        say(`  discovery failed: ${e.message} — waypost profile to retry`);
      }
    });
  }

  // Not run(): doctor is a diagnostic, and `--fix` only mends what is
  // mechanical — a harness/spec/layout finding it cannot touch must not turn
  // `waypost setup` into a hard failure for having done the mechanical part of
  // its job. spawnSync here so setup can read and print the report itself
  // and add the one line that matters: whether anything still needs a human.
  step("repair the mechanical install findings", () => {
    const r = spawnSync(process.execPath, [SCRIPT("doctor"), "--install", "--fix"], {
      encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
    });
    process.stdout.write(r.stdout || "");
    if (r.stderr) process.stderr.write(r.stderr);
    const m = (r.stdout || "").match(/Summary: (\d+) issue/);
    if (m && Number(m[1]) > 0) process.stdout.write(`${m[1]} finding(s) remain — waypost doctor\n`);
  });

  // WP-17, the clean stories (ADR "Disk hygiene by discovery" Decision 6):
  // the audit as setup's own last step, after repair, before the footer.
  // Never takes setup down with it — a slot refusal or any other failure is
  // reported and setup still exits 0; setup itself removes nothing without
  // the same yes `waypost clean --apply` needs, asked at most once here.
  await step("audit build output (project, and the machine if its profile was just refreshed)", async () => {
    try {
      const capacity = await import(`file://${SCRIPT("capacity")}`);
      const presence = await import(`file://${SCRIPT("presence")}`);
      const dir = slotsDir(presence);
      mkdirSync(dir, { recursive: true });
      const claim = await claimSlot(dir, ["waypost", "setup", "--audit"], capacity, presence);
      if (!claim.ok) {
        say(`  audit skipped: ${claim.reason} — waypost clean`);
        return;
      }
      recordAuthority(claim.file, capacity);
      try {
        const cleanup = await import(`file://${SCRIPT("cleanup")}`);
        const sizes = await import(`file://${SCRIPT("sizes")}`);
        const toolchains = await import(`file://${SCRIPT("toolchains")}`);
        const discovery = await import(`file://${SCRIPT("discovery")}`);
        const mods = { cleanup, sizes, toolchains, presence, discovery };
        const auditNow = cleanNow();
        const ctx = gatherCleanContext(mods, { budget: sizes.DEFAULT_ENTRY_BUDGET, includeMachine: machineRefreshedThisRun });
        const classified = planFromContext(ctx, cleanup, auditNow);
        printAuditSummary(classified, say, ctx.inUseSignal);

        const shouldItems = classified.filter((it) => it.class === "should");
        const isTTY = Boolean(process.stdin.isTTY);
        const harnessDetected = await isHarnessDetected();
        if (shouldItems.length && isTTY && !harnessDetected) {
          const consent = cleanup.consent({ yes: false, reason: null, isTTY, harnessDetected });
          const result = await applyClean({ mode: "should" }, consent, mods, auditNow, { source: "setup", prebuilt: { ctx, classified } });
          if (result.declined) {
            say("  not confirmed — nothing removed");
          } else {
            const removedCount = result.items.filter((i) => i.result === "removed" || i.result === "partial").length;
            say(`  removed ${removedCount} item(s) — waypost clean for the rest`);
          }
        } else if (shouldItems.length) {
          say("  review and remove: waypost clean");
        }
      } finally {
        claim.release();
      }
    } catch (e) {
      say(`  audit failed: ${e.message} — waypost clean to retry`);
    }
  });

  if (!dry) {
    process.stdout.write("\nready. Next:\n");
    process.stdout.write("  waypost next                      what this project needs right now\n");
    process.stdout.write("  waypost brief                     orientation at the start of a session\n");
    process.stdout.write('  waypost draft adr "<decision>" --write\n');
  }
}

// A vault the project already has, or a conventional place for a new one. Never
// a path outside the project: the vault travels with the repository unless the
// user says otherwise.
function guessVault() {
  const root = projectRoot();
  for (const c of ["vault", "docs/vault", "knowledge", ".vault"]) {
    if (existsSync(join(root, c, "adr")) || existsSync(join(root, c, "epics"))) return join(root, c);
  }
  return join(root, existsSync(join(root, "docs")) ? "docs/vault" : "vault");
}

function detectedHarnesses() {
  try {
    return JSON.parse(run("agents", ["harnesses", "--json"], { capture: true }))
      .harnesses.filter((h) => (h.detect || []).some((d) => existsSync(join(projectRoot(), d))))
      .map((h) => h.id);
  } catch { return []; }
}

function passThrough(args, names) {
  const out = [];
  for (const n of names) { const v = opt(args, n); if (v) out.push(n, v); }
  return out;
}

// A finding's message, trimmed to its lead clause for a one-line summary:
// split on " — " first (several finding generators use it deliberately as a
// clause separator), else on the first SENTENCE-ending period (one followed
// by whitespace or end of string) — never the first bare ".", which cuts a
// message off mid-path on anything naming a file (kanban.md, .gitattributes,
// .waypost/…) or a domain-shaped word.
function leadClause(message) {
  const dash = message.split(" — ")[0];
  return dash !== message ? dash : message.split(/\.(?:\s|$)/)[0];
}

// ─── next: what this project needs right now ───────────────────────────
//
// The judgement an agent otherwise has to make from scratch every session, made
// deterministically instead: read the state, rank what is actionable, print the
// command. Cheap by construction — no artifact content, one line per item.
function handleNext(args) {
  const cfg = readConfig();
  const items = [];
  if (!cfg || !cfg.vault_path) {
    process.stdout.write("not bound to a vault yet — run `waypost setup`\n");
    return;
  }
  const findings = (() => {
    try { return JSON.parse(run("doctor", ["--json"], { capture: true })); } catch { return []; }
  })();
  const by = (check, level) => findings.filter((f) => f.check === check && (!level || f.level === level));

  for (const f of findings.filter((f) => f.level === "issue")) {
    items.push([1, leadClause(f.message).slice(0, 110), repairFor(f)]);
  }
  const state = (() => {
    try { return JSON.parse(run("sessions", ["--json"], { capture: true })); } catch { return {}; }
  })();
  for (const c of (state.claims || []).filter((c) => c.session !== state.session_id)) {
    items.push([2, `${c.story} is being worked on by ${c.session} (${c.harness || "?"}, ${c.host})`,
      "coordinate before touching it"]);
  }
  // Ready work outranks warnings: an unblocked, unclaimed story is what a
  // session came for (WP-15). Three at most; `waypost ready` has the rest.
  const ready = (() => {
    try { return JSON.parse(run("ready", ["--json"], { capture: true })).ready || []; } catch { return []; }
  })();
  for (const s of ready.slice(0, 3)) {
    items.push([2, `ready: ${s.title} (${s.epic}, ${s.priority})`, `waypost story plan ${s.rel} --write`]);
  }
  for (const f of by("work-without-story", "warn")) {
    items.push([3, "source changes with no story open", 'waypost draft story <EPIC> "<title>" --write']);
  }
  for (const f of findings.filter((f) => f.level === "warn" && f.check !== "work-without-story")) {
    items.push([4, leadClause(f.message).slice(0, 110), repairFor(f)]);
  }
  for (const f of by("agent-roles", "info").concat(by("agents-block", "info"))) {
    items.push([5, leadClause(f.message).slice(0, 110), repairFor(f)]);
  }

  if (!items.length) {
    process.stdout.write("nothing needs doing: vault consistent, roles installed, no conflicting session.\n"
      + "Next feature-sized change starts with `waypost draft story <EPIC> \"<title>\" --write`.\n");
    return;
  }
  items.sort((a, b) => a[0] - b[0]);
  for (const [, what, how] of items.slice(0, 8)) {
    process.stdout.write(`- ${what}\n${how ? `    ${how}\n` : ""}`);
  }
  if (items.length > 8) process.stdout.write(`…and ${items.length - 8} more (waypost doctor)\n`);
}

function repairFor(f) {
  if (f.check === "code-refs") return "fix the path, or mark it (waiting)/(planned)/(deleted)";
  if (f.check === "supersedes") return "correct supersedes/superseded_by on both artifacts";
  if (f.check === "acceptance-gate") return "record the review outcome in review_status";
  const map = {
    kanban: "waypost reconcile --write", "code-map": "waypost reconcile --write", indexes: "waypost reconcile --write",
    graph: "waypost graph", "agent-roles": "waypost agents install", "agents-block": "waypost agents register",
    gitignore: "waypost doctor --fix", "vault-git": "waypost doctor --fix", "merge-driver": "waypost doctor --fix",
    "line-endings": "waypost doctor --fix", config: "waypost setup",
    "claude-bridge": "waypost doctor --fix", "instructions-size": "waypost doctor",
    "story-deps": "waypost ready --all", "adr-number": "waypost doctor", "adr-guard": "waypost doctor",
    "agent-skills": "waypost skills install", launcher: "waypost launcher --write",
  };
  return map[f.check] || null;
}

// ─── bind ──────────────────────────────────────────────────────────────

// A-2: shared by handleBind (a --layout flag) and handleScaffold (a layout
// already sitting in .waypost/projectstore.json) — a bad value in either place
// must get this same actionable message, not a raw ENOENT from whichever
// readFileSync happens to hit it first.
function checkLayoutExists(layout) {
  if (!existsSync(join(ROOT, "scaffold", "layouts", `${layout}.json`))) {
    fail(`unknown layout "${layout}" — available: ${readdirSync(join(ROOT, "scaffold", "layouts")).map((n) => n.replace(/\.json$/, "")).join(", ")}`);
  }
}

function handleBind(args) {
  const [vault] = positionals(args);
  if (!vault) fail('bind <vault-path> [--layout engineering] [--lang en|ru|es|de|fr|zh]');
  const abs = resolve(expandHome(vault));
  // A re-bind keeps what the project already chose: `waypost bind <same vault>`
  // used to reset language and layout to their defaults unless both flags were
  // repeated, which is how a Russian vault came back English.
  const existing = readConfig();
  const layout = opt(args, "--layout", (existing && existing.layout) || "engineering");
  const lang = opt(args, "--lang", (existing && existing.language) || "en");
  checkLayoutExists(layout);
  if (!existsSync(join(ROOT, "templates", lang))) {
    fail(`unknown language "${lang}" — available: ${readdirSync(join(ROOT, "templates")).filter((n) => !n.includes(".")).join(", ")}`);
  }
  if (existing && existing.vault_path && resolve(existing.vault_path) !== abs && !flag(args, "--force")) {
    fail(`already bound to ${existing.vault_path} — re-run with --force to rebind to ${abs}`);
  }
  mkdirSync(abs, { recursive: true });
  const cfgPath = join(projectRoot(), ".waypost", "projectstore.json");
  mkdirSync(dirname(cfgPath), { recursive: true });
  const stored = storedVaultPath(abs);
  const cfg = {
    ...(existing || {}),
    vault_path: stored,
    layout,
    language: lang,
    default_author: (existing && existing.default_author) || gitUser(),
    waypost: { version: VERSION },
  };
  writeFileSync(cfgPath, JSON.stringify(cfg, null, 2) + "\n", "utf8");
  process.stdout.write(`bound  ${abs}${stored !== abs ? `  (stored as ${stored}, relative to the project)` : ""}\nconfig ${cfgPath}\n`);
  process.env.WAYPOST_PROJECT_DIR = projectRoot();
  handleScaffold([]);
  process.stdout.write(
    "\nnext:\n" +
    "  waypost agents install         install the roles into the harnesses this project uses\n" +
    '  waypost draft adr "<title>" --write\n' +
    "  waypost doctor\n",
  );
}

function gitUser() {
  const r = spawnSync("git", ["config", "--get", "user.name"], { encoding: "utf8" });
  return (r.stdout || "").trim() || process.env.USER || "unknown";
}

// ─── scaffold ──────────────────────────────────────────────────────────

// The deterministic half of upstream's /bind: layout folders and their index
// READMEs. Prose lives in prompts/bind.md; the directories are mechanical, so
// they are the CLI's job and never an LLM's.
function handleScaffold(args) {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) fail("no bound vault — run `waypost bind <vault-path>` first");
  checkLayoutExists(cfg.layout || "engineering");
  const layout = JSON.parse(readFileSync(join(ROOT, "scaffold", "layouts", `${cfg.layout || "engineering"}.json`), "utf8"));
  const lang = cfg.language || "en";
  const created = [];
  for (const folder of layout.folders) {
    const dir = join(cfg.vault_path, folder.path);
    if (!existsSync(dir)) { mkdirSync(dir, { recursive: true }); created.push(folder.path + "/"); }
    if (!folder.readme) continue;
    const p = join(dir, "README.md");
    if (existsSync(p)) continue;
    const tmpl = readFileSync(join(ROOT, "templates", lang, "folder-readme.md.tmpl"), "utf8");
    const title = folder.path.charAt(0).toUpperCase() + folder.path.slice(1);
    // doctor reads the first prose paragraph as the folder's purpose, so the
    // default has to say what the folder holds, not merely name it.
    writeFileSync(p, tmpl
      .replace(/\{\{folder_name\}\}/g, title)
      .replace(/\{\{folder_description\}\}/g,
        `\`${folder.kind}\` artifacts of the \`${layout.name}\` layout, maintained by waypost.`), "utf8");
    created.push(`${folder.path}/README.md`);
  }
  if (flag(args, "--json")) { process.stdout.write(JSON.stringify({ created }, null, 2) + "\n"); return; }
  if (!created.length) process.stdout.write("scaffold: vault already complete\n");
  else process.stdout.write(`scaffold: created ${created.length} item(s)\n  ${created.join("\n  ")}\n`);
}

// ─── draft ─────────────────────────────────────────────────────────────

function handleDraft(args) {
  const pos = positionals(args);
  const [kind, ...rest] = pos;
  if (!kind || !rest.length) {
    fail('draft <adr|spec|epic|story|research|concept|meeting|runbook> "<title>" [--write] [--lang <code>]\n' +
         '       draft epic <EPIC-ID> "<title>"   |   draft story <EPIC-ID> "<title>"');
  }
  const lang = opt(args, "--lang");
  const out = runJson("draft", [kind, ...rest, ...(lang ? ["--lang", lang] : [])]);
  if (!flag(args, "--write")) {
    if (flag(args, "--json")) { process.stdout.write(JSON.stringify(out, null, 2) + "\n"); return; }
    // A preview used to print the whole rendered artifact — several hundred
    // tokens of template the reader is about to see on disk anyway. What a
    // decision needs is: where it lands, what the index row says, what is wrong.
    process.stdout.write(`would create ${out.path}\n`);
    if (out.index && out.index.line) process.stdout.write(`index row     ${out.index.line}\n`);
    if (out.collision) process.stdout.write(`⚠️  collision  "${out.collision.identity || ""}" already exists as ${out.collision.with}\n`);
    for (const w of out.warnings || []) process.stdout.write(`⚠️  ${w}\n`);
    const head = String(out.content).split("\n").slice(0, 8).join("\n");
    process.stdout.write(`\n${head}\n…\n\n--write to create it · --json for the full payload\n`);
    return;
  }
  if (out.collision) {
    fail(`topic collision: "${out.collision.identity || kind}" already exists as ${out.collision.with}. ` +
         "Extend that artifact, or pick a different title.");
  }
  if (existsSync(out.path)) fail(`refusing to overwrite ${out.path}`);
  mkdirSync(dirname(out.path), { recursive: true });
  // sweep:false — this directory is not reconcile's own regeneration loop,
  // so there is no reason to pay for scanning it for orphaned temps here.
  writeFileAtomic(out.path, out.content, { sweep: false });
  process.stdout.write(`created ${out.path}\n`);
  for (const w of out.warnings || []) process.stdout.write(`⚠️  ${w}\n`);
  // The index row and the board are derived views: regenerate rather than
  // patch, so a hand-edit can never leave them permanently out of step. The
  // artifact is already on disk at this point, so a reconcile failure must be
  // reported against it rather than exiting as if the write had not happened.
  reconcileAfterWrite();
}

function reconcileAfterWrite() {
  const r = spawnSync(process.execPath, [SCRIPT("reconcile"), "--write"], {
    encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
  });
  let failed = [];
  let did = null;
  try {
    const out = JSON.parse(r.stdout || "{}");
    failed = [out.kanban, out.codemap, out.graph, ...(out.indexes || [])]
      .filter((t) => t && t.error).map((t) => `${t.path || t.target || "?"}: ${t.error}`);
    // Name only the views that were actually (re)written: the message used to
    // claim "code-map, graph" even on a fresh vault where both are skipped by
    // design, one line above doctor's own "No graph.md yet" (E-2).
    const wrote = [];
    if ((out.indexes || []).some((t) => t && t.written)) wrote.push("indexes");
    for (const k of ["kanban", "codemap", "graph"]) if (out[k] && out[k].written) wrote.push(k === "codemap" ? "code-map" : k);
    did = wrote;
  } catch { /* fall through to the exit code */ }
  if (r.status === 0 && !failed.length) {
    process.stdout.write(did && did.length
      ? `derived views reconciled (${did.join(", ")})\n`
      : did ? "derived views already up to date\n"
      : "derived views reconciled\n");
    return;
  }
  process.stderr.write("waypost: the artifact was written, but reconciling the derived views failed:\n"
    + (failed.length ? failed.map((f) => `  ${f}\n`).join("") : `  ${(r.stderr || "").trim()}\n`)
    + "  fix the cause, then run `waypost reconcile --write`.\n");
  process.exitCode = 1;
}

// ─── story gates ───────────────────────────────────────────────────────

function handleStory(args) {
  const [mode, storyPath] = positionals(args);
  if (!["plan", "close"].includes(mode) || !storyPath) {
    fail("story <plan|close> <story-path> [--write]");
  }
  const out = runJson("story-section", [mode, storyPath]);
  if (!flag(args, "--write")) {
    process.stdout.write(JSON.stringify({ ...out, content: undefined }, null, 2) + "\n");
    process.stdout.write("(preview only — re-run with --write to apply)\n");
    return;
  }
  // story-section.mjs will transform any file with a frontmatter block, not
  // only a real vault story — refuse to write anywhere outside the bound
  // vault rather than trust a positional path the caller supplied.
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path || !isInsideVault(resolve(out.path), cfg.vault_path)) {
    fail(`refusing to write outside the vault: ${out.path}`);
  }
  if (!out.changed) { process.stdout.write(`unchanged ${out.path}\n`); return; }
  // Re-check against the file story-section actually read: between that read
  // and this write another session (or a hand edit) may have changed it, and
  // `content` was computed from the OLD bytes — writing it now would silently
  // discard the concurrent edit.
  let current;
  try { current = readFileSync(out.path, "utf8"); } catch (e) { fail(`${out.path}: ${e.message}`); }
  if (createHash("sha256").update(current, "utf8").digest("hex") !== out.original_sha256) {
    fail(`${out.path} changed since it was read — re-run`);
  }
  // sweep:false — same reasoning as handleDraft's write.
  writeFileAtomic(out.path, out.content, { sweep: false });
  process.stdout.write(`${mode}  ${out.path}\n  ${(out.notes || []).join("\n  ")}\n`);
  // Opening a story claims it for this session; closing it releases the claim.
  // Other harnesses on the same vault read that registry, so the gate is also
  // the announcement — nobody has to remember a separate command.
  claimForStory(mode === "plan" ? out.path : null, cfg.vault_path);
  reconcileAfterWrite();
}

function claimForStory(storyPath, vault) {
  // Warn, do not refuse: re-planning a story someone else opened changes the
  // file idempotently, and the moment that actually needs a gate is the commit.
  // But the session that is about to duplicate work should hear about it here.
  if (storyPath) {
    const r = spawnSync(process.execPath, [SCRIPT("sessions"), "--json"], {
      encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
    });
    try {
      const { claims = [], session_id: self } = JSON.parse(r.stdout || "{}");
      const ref = storyRefOf(storyPath, vault);
      const others = ref ? claims.filter((c) => c.story === ref && c.session !== self) : [];
      if (others.length) {
        process.stderr.write(`⚠️  ${ref} is already claimed by ${others.map((o) => `${o.session} (${o.harness || "?"})`).join(", ")}`
          + " — two sessions on one story is how the same work gets done twice.\n");
      }
    } catch { /* the registry is advisory; never block the gate on it */ }
  }
  const args = storyPath ? ["--claim", storyPath] : ["--release"];
  const r = spawnSync(process.execPath, [SCRIPT("sessions"), ...args], {
    encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
  });
  const line = (r.stdout || "").split("\n").find((l) => l.startsWith("claimed") || l.startsWith("released"));
  if (line) process.stdout.write(`  ${line.trim()}  (visible to other sessions via \`waypost sessions\`)\n`);
}

// ─── derived views ─────────────────────────────────────────────────────

const DERIVED = { kanban: "kanban", graph: "graph", codemap: "codemap" };

// A graph or an index grows with the vault: at 200 artifacts graph.md is ~13k
// tokens and an index ~10k. Reading either whole to answer one question is the
// single largest avoidable cost on a big project, so the CLI answers the
// question instead — the derived views stay the source, this is just a lens.
function handleGraphQuery(target, args) {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) fail("no bound vault — run `waypost bind <vault-path>` first");
  const p = join(cfg.vault_path, "graph.md");
  if (!existsSync(p)) fail("no graph.md yet — run `waypost graph`");
  const needle = target.replace(/\\/g, "/").replace(/^\.\//, "");
  const lines = readFileSync(p, "utf8").split("\n");
  const hits = lines.filter((l) => l.includes(needle) && l.startsWith("|"));
  if (!hits.length) {
    fail(`no node or edge mentions "${needle}" in graph.md.\n`
      + "       Nodes are keyed by vault-relative path (adr/foo.md), not by slug.");
  }
  const node = hits.filter((l) => !/\|\s*(supersedes|superseded_by|covers|covered_by|contains|part_of|links|link)\s*\|/i.test(l));
  const edges = hits.filter((l) => !node.includes(l));
  process.stdout.write(`${needle}\n`);
  for (const l of node) process.stdout.write(`  ${l.replace(/^\|\s*/, "").replace(/\s*\|\s*$/, "").replace(/\s*\|\s*/g, " · ")}\n`);
  if (edges.length) {
    process.stdout.write(`\nedges (${edges.length}):\n`);
    for (const l of edges.slice(0, 60)) {
      process.stdout.write(`  ${l.replace(/^\|\s*/, "").replace(/\s*\|\s*$/, "").replace(/\s*\|\s*/g, " → ")}\n`);
    }
    if (edges.length > 60) process.stdout.write(`  …and ${edges.length - 60} more\n`);
  }
}

// Vault-wide search that returns pointers, not documents: path, title, status
// and the matching line. The alternative an agent falls back to is grep plus a
// handful of full-file reads.
function handleSearch(args) {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) fail("no bound vault — run `waypost bind <vault-path>` first");
  const terms = positionals(args);
  if (!terms.length) fail('search "<text>" [--kind adr|spec|epic|story|…] [--limit 20]');
  const kind = opt(args, "--kind");
  const limitRaw = opt(args, "--limit", "20");
  const limit = Number(limitRaw);
  if (!Number.isInteger(limit) || limit <= 0) fail(`--limit must be a positive integer, got "${limitRaw}"`);
  const re = new RegExp(terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|"), "i");
  const out = [];
  // iCloud leaves a placeholder — ".<name>.icloud" — for a file evicted from
  // local storage; the real name never appears in the listing until it syncs
  // back down. Counted, not searched: its content is not on disk to match.
  const notDownloaded = [];
  const walk = (dir, rel) => {
    let names = [];
    try { names = readdirSync(dir); } catch { return; }
    for (const n of names) {
      if (n.startsWith(".")) {
        const icloud = /^\.(.+)\.icloud$/.exec(n);
        if (icloud) notDownloaded.push(rel ? `${rel}/${icloud[1]}` : icloud[1]);
        continue;
      }
      const abs = join(dir, n);
      const r = rel ? `${rel}/${n}` : n;
      let lst; try { lst = lstatSync(abs); } catch { continue; }
      // A symlinked directory is never descended into: cheap protection
      // against a cycle (a directory symlinked into itself or an ancestor),
      // at the cost of not walking a legitimate symlinked subtree. A
      // symlinked FILE falls through to the same read path as a real one.
      if (lst.isSymbolicLink()) {
        let target; try { target = statSync(abs); } catch { continue; }
        if (target.isDirectory()) continue;
      } else if (lst.isDirectory()) {
        walk(abs, r);
        continue;
      } else if (!lst.isFile()) {
        continue;
      }
      if (!n.endsWith(".md")) continue;
      if (["kanban.md", "graph.md", "code-map.md"].includes(n)) continue;
      let text; try { text = readFileSync(abs, "utf8"); } catch { continue; }
      // parseFrontmatter, not an inline \n-only regex: a CRLF or BOM file
      // (the exact shape doctor's own cross-OS checks exist to catch before
      // it is fixed) used to read as "no frontmatter at all" here, so
      // `--kind` silently dropped every match and title/status came back
      // from the filename instead of the artifact's own fields.
      const fm = parseFrontmatter(text).data;
      if (kind && String(fm.type ?? "") !== kind) continue;
      const lines = text.split("\n");
      const hitLine = lines.findIndex((l) => re.test(l));
      if (hitLine === -1 && !re.test(r)) continue;
      out.push({ path: r, title: String(fm.title ?? "") || n, status: fm.status == null ? "" : String(fm.status),
        line: hitLine === -1 ? null : `${hitLine + 1}: ${lines[hitLine].trim().slice(0, 120)}` });
    }
  };
  walk(cfg.vault_path, "");
  if (!out.length) { process.stdout.write("no match\n"); }
  else {
    for (const h of out.slice(0, limit)) {
      process.stdout.write(`${h.path}${h.status ? `  (${h.status})` : ""}\n  ${h.title}\n`
        + (h.line ? `  ${h.line}\n` : ""));
    }
    if (out.length > limit) process.stdout.write(`…and ${out.length - limit} more (--limit)\n`);
  }
  if (notDownloaded.length) {
    process.stdout.write(`${notDownloaded.length} file(s) not downloaded from iCloud — open them once to sync\n`);
  }
}

function handleDerived(cmd, args) {
  if (flag(args, "--json")) { process.stdout.write(run(cmd, [], { capture: true })); return; }
  const out = runJson("reconcile", ["--write", "--only", DERIVED[cmd]]);
  const target = out[cmd] || {};
  if (target.error) fail(`${cmd}: ${target.error}`);
  if (target.skipped) { process.stdout.write(`${cmd}: ${target.skipped}\n`); return; }
  process.stdout.write(`${target.written ? "written" : "unchanged"} ${target.path || cmd}\n`);
}

// `waypost reconcile` is listed beside kanban/graph/codemap, so it answers in
// the same voice — a line per view — instead of the raw JSON its programmatic
// callers (draft, commit, the merge driver) consume. `--json` still yields that
// shape for anyone composing it.
function handleReconcile(args) {
  if (flag(args, "--json")) { process.stdout.write(run("reconcile", args.filter((a) => a !== "--json"), { capture: true })); return; }
  const wrote = flag(args, "--write");
  const out = runJson("reconcile", args);
  const line = (label, t) => {
    if (!t) return;
    if (t.error) { process.stdout.write(`  ${label}: error — ${t.error}\n`); return; }
    if (t.skipped) { process.stdout.write(`  ${label}: ${t.skipped}\n`); return; }
    process.stdout.write(`  ${label}: ${t.written ? "written" : "unchanged"}${t.path ? ` ${t.path}` : ""}\n`);
  };
  process.stdout.write(`${wrote ? "reconciled" : "dry run (nothing written; add --write)"}\n`);
  line("kanban", out.kanban);
  line("code-map", out.codemap);
  line("graph", out.graph);
  for (const idx of out.indexes || []) line(idx.path || "index", idx);
  if (out.summary && out.summary.failed > 0) process.exitCode = 1;
}

// ─── prompts & skills ──────────────────────────────────────────────────

function printDoc(dir, name, suffix) {
  const base = join(ROOT, dir);
  const names = readdirSync(base)
    .map((n) => n.replace(/\.md$/, ""))
    .filter((n) => !n.startsWith("."))
    .sort();
  if (!name) {
    process.stdout.write(`${dir}:\n  ${names.join("\n  ")}\n\nPrint one with: waypost ${dir === "prompts" ? "prompt" : "skill"} <name>\n`);
    return;
  }
  // A name, never a path: `waypost prompt ../README` used to print whatever the
  // traversal landed on.
  if (!/^[\w.-]+$/.test(name) || name.includes("..")) fail(`not a valid name: ${name}`);
  // Bundled skills carry the waypost- prefix (the standard wants a name
  // that is unique across every skill a harness loads); the short name
  // still works here.
  if (suffix && !existsSync(join(base, name, suffix)) && existsSync(join(base, `waypost-${name}`, suffix))) name = `waypost-${name}`;
  const p = suffix ? join(base, name, suffix) : join(base, `${name}.md`);
  if (!existsSync(p)) fail(`no such ${dir === "prompts" ? "prompt" : "skill"}: ${name} (have: ${names.join(", ")})`);
  process.stdout.write(readFileSync(p, "utf8"));
}

// ─── profile ─────────────────────────────────────────────────────────────
//
// WP-17, the discovery story, ADR Decision 2: the machine and project
// profiles — the scheme of what waypost works with. discovery.mjs is
// compute only (detection, asking, no fs writes); this is the one place
// that reads the previous profile, decides whether it is due (missing,
// older than 30 days, or --refresh — discovery.mjs's needsRefresh), rebuilds
// it, and writes it back atomically — the same division every other write
// in this file keeps with its scripts/*.mjs collaborator. Shared by
// `waypost profile` and `waypost setup`'s own discovery step, so both apply
// the exact same refresh rule.
async function refreshProfiles({ force = false } = {}) {
  const discovery = await import(`file://${SCRIPT("discovery")}`);
  const toolchains = await import(`file://${SCRIPT("toolchains")}`);
  const presence = await import(`file://${SCRIPT("presence")}`);
  const root = projectRoot();
  const host = presence.hostSlug();
  const home = homedir();
  const reg = toolchains.loadRegistry({ projectRoot: root, platform: process.platform });

  const machinePath = discovery.machineProfilePath({ home, host });
  // A profile that exists but does not parse is treated exactly like a
  // missing one — needsRefresh(null, …) is always true — so a hand-edited or
  // half-written file is silently repaired on the next refresh rather than
  // wedging this command the way an unreadable projectstore.json must not.
  const load = (p) => {
    if (!existsSync(p)) return null;
    try { return JSON.parse(readFileSync(p, "utf8")); } catch { return null; }
  };

  let machine = load(machinePath);
  const machineRefreshed = discovery.needsRefresh(machine, { force });
  if (machineRefreshed) {
    machine = discovery.buildMachineProfile(reg.entries, { home, host });
    mkdirSync(dirname(machinePath), { recursive: true });
    writeFileAtomic(machinePath, JSON.stringify(machine, null, 2) + "\n");
  }

  // Item 6: a project AT $HOME (no project bound, cwd left at the user's
  // home, WAYPOST_PROJECT_DIR unset or pointed at ~) must never get a
  // project.<host>.json written into ~/.waypost/state/ — the same "no
  // project here" `waypost size --project` already enforces by refusing to
  // scan $HOME (scripts/sizes.mjs). No project profile is built at all.
  const noProject = resolve(root) === resolve(home);
  let project = null, projectPath = null, projectRefreshed = false;
  if (!noProject) {
    projectPath = discovery.projectProfilePath({ projectRoot: root, host });
    project = load(projectPath);
    projectRefreshed = discovery.needsRefresh(project, { force });
    if (projectRefreshed) {
      project = discovery.buildProjectProfile(reg.entries, { projectRoot: root, host });
      mkdirSync(dirname(projectPath), { recursive: true });
      writeFileAtomic(projectPath, JSON.stringify(project, null, 2) + "\n");
    }
  }

  return { host, machine, machinePath, machineRefreshed, project, projectPath, projectRefreshed, noProject, notes: reg.notes };
}

async function handleProfile(args) {
  let r;
  try {
    r = await refreshProfiles({ force: flag(args, "--refresh") });
  } catch (e) { fail(`profile: ${e.message}`); }

  if (flag(args, "--json")) {
    process.stdout.write(JSON.stringify({ machine: r.machine, project: r.noProject ? null : r.project, notes: r.notes }, null, 2) + "\n");
    return;
  }

  process.stdout.write(`host  ${r.host}\n`);
  process.stdout.write(`machine  ${tildeHome(r.machinePath)}  (${r.machineRefreshed ? "refreshed" : "kept"}, ${r.machine.generated_at})\n`);
  process.stdout.write(`  ${r.machine.platform}/${r.machine.arch}\n`);
  for (const t of r.machine.tools) process.stdout.write(`  tool       ${t.name} (${t.id})  ${t.bin}\n`);
  for (const c of r.machine.caches) {
    process.stdout.write(`  cache      ${tildeHome(c.path)}  [${c.tool} · ${c.source}]${c.ask_note ? `  (asked: ${c.ask_note})` : ""}\n`);
  }
  if (r.noProject) {
    process.stdout.write("no project here — machine profile only\n");
  } else {
    process.stdout.write(`project  ${tildeHome(r.projectPath)}  (${r.projectRefreshed ? "refreshed" : "kept"}, ${r.project.generated_at})\n`);
    for (const e of r.project.ecosystems) process.stdout.write(`  ecosystem  ${e.name} (${e.id})  ${e.manifest}\n`);
  }
  // ADR Decision 1: a project's own .waypost/toolchains/ entry may only be
  // data — every dropped field is a project author reaching for something
  // this profile refuses to run, so it belongs here, not just in doctor.
  if (r.notes.length) {
    process.stdout.write(`\n${r.notes.length} note(s) from .waypost/toolchains/:\n`);
    for (const n of r.notes) process.stdout.write(`  ${n.file}${n.field ? ` (${n.field})` : ""}: ${n.reason}\n`);
  }
}

// ─── size ──────────────────────────────────────────────────────────────
//
// Read-only measurement of build artifacts and dev caches (WP-17, "Disk
// hygiene by discovery"): never writes, never deletes. A dynamic
// import(), the way selfInstall reaches agents.mjs above — in-process, not
// a subprocess — so a later `doctor` check can share this exact code.
const GB = 1024 ** 3;

function tildeHome(p) {
  const home = homedir();
  return p === home || p.startsWith(home + sep) ? `~${p.slice(home.length)}` : p;
}

async function handleSize(args) {
  let sizes, toolchains;
  try {
    sizes = await import(`file://${SCRIPT("sizes")}`);
    toolchains = await import(`file://${SCRIPT("toolchains")}`);
  } catch (e) { fail(`size: ${e.message}`); }
  const json = flag(args, "--json");

  if (flag(args, "--global")) {
    // WP-18 Decision 4: a whole-disk scan is heavy work too, so it holds a
    // machine-wide slot exactly like `waypost run --heavy` — same refusal
    // (exit 75), same reason and retry line. No `fail()` (process.exit)
    // between the claim and the finally below, so the slot is always
    // released, even when the scan itself throws.
    let capacity, presence;
    try {
      capacity = await import(`file://${SCRIPT("capacity")}`);
      presence = await import(`file://${SCRIPT("presence")}`);
    } catch (e) { fail(`size --global: ${e.message}`); }
    const dir = slotsDir(presence);
    mkdirSync(dir, { recursive: true });
    const claim = await claimSlot(dir, ["waypost", "size", "--global"], capacity, presence);
    if (!claim.ok) {
      process.stderr.write(`waypost size --global: refused — ${claim.reason}\n  retry: waypost size --global\n`);
      process.exitCode = EX_TEMPFAIL;
      return;
    }
    // Same as run --heavy: the authority goes into the record after the lock
    // is released, never before it (third amendment).
    recordAuthority(claim.file, capacity);
    let out, reg, error, usedProfile = false;
    try {
      reg = toolchains.loadRegistry({ projectRoot: projectRoot(), platform: process.platform });
      // WP-17, the discovery story: a fresh machine profile for THIS host and
      // platform (built by `waypost profile`/`waypost setup`, never here —
      // `size` stays read-only, Decision 3 of the ADR) is measured directly;
      // otherwise today's path, unchanged. A profile is never rebuilt or
      // refreshed by this command.
      const discovery = await import(`file://${SCRIPT("discovery")}`);
      const host = presence.hostSlug();
      const machinePath = discovery.machineProfilePath({ home: homedir(), host });
      let machine = null;
      if (existsSync(machinePath)) {
        try { machine = JSON.parse(readFileSync(machinePath, "utf8")); } catch { machine = null; }
      }
      // Item 7: a profile missing its own `caches` array (corrupt, or an
      // older shape from before the fact-only profile) is not "fresh" —
      // fall back to the registry entirely rather than measure nothing.
      const fresh = machine && machine.platform === process.platform
        && Array.isArray(machine.caches) && !discovery.needsRefresh(machine, {});
      // The registry travels WITH the profile (ADR Decision 2): a profile
      // holds facts only (tool/item/path/source), never clean/regenerable/
      // confidence/docs/notes — scanGlobal reattaches that policy from
      // THIS, the current, registry, matched by (tool, item), so a fixed
      // `regenerable` or `clean` is visible here at once, never stale for
      // up to 30 days waiting on the next profile refresh.
      out = fresh ? sizes.scanGlobal({ profile: machine, registry: reg }) : sizes.scanGlobal({ registry: reg });
      usedProfile = Boolean(fresh);
    } catch (e) {
      error = e;
    } finally {
      claim.release();
    }
    if (error) fail(`size --global: ${error.message}`);
    if (json) {
      process.stdout.write(JSON.stringify({
        caches: out, notes: reg.notes, profile_used: usedProfile,
        ...(usedProfile && out.dropped ? { profile_stale_items: out.dropped } : {}),
      }, null, 2) + "\n");
      return;
    }
    if (!usedProfile) {
      process.stdout.write("no fresh machine profile for this host — measuring the shipped registry's own defaults (waypost profile to build one)\n");
    } else if (out.dropped) {
      process.stdout.write(`${out.dropped} cache item(s) in the profile are no longer in the registry — registry changed — waypost profile --refresh\n`);
    }
    const threshold = 0.1 * GB;
    const big = out.filter((e) => e.bytes >= threshold).sort((a, b) => b.bytes - a.bytes);
    if (!big.length) { process.stdout.write("no caches at or above 0.1 GB found (waypost size --global --json for the rest)\n"); }
    for (const e of big) {
      process.stdout.write(`  ${(e.bytes / GB).toFixed(1)} GB  ${tildeHome(e.path)}  [${e.tool} · ${e.source}]\n    → ${e.clean}\n`);
    }
    const small = out.length - big.length;
    if (small > 0) process.stdout.write(`…and ${small} more below 0.1 GB (--json for all)\n`);
    if (reg.notes.length) process.stdout.write(`\n${reg.notes.length} note(s) from .waypost/toolchains/ (--json for detail)\n`);
    return;
  }

  const bi = args.indexOf("--budget");
  let budget = null;
  if (bi !== -1) {
    const v = args[bi + 1];
    if (v === undefined) fail("--budget requires a value");
    budget = Number(v);
    if (!Number.isInteger(budget) || budget < 0) fail(`--budget must be a non-negative integer, got "${v}"`);
  }

  // A local extractor: the shared opt() does not know --project's value is
  // optional, and would swallow --json as the directory (A-8's own lesson,
  // applied here rather than reused, since --project's arity differs from
  // every other flag in VALUED).
  const pi = args.indexOf("--project");
  const dir = pi !== -1 && args[pi + 1] !== undefined && !args[pi + 1].startsWith("--")
    ? resolve(expandHome(args[pi + 1]))
    : projectRoot();

  let out, reg;
  try {
    reg = toolchains.loadRegistry({ projectRoot: dir, platform: process.platform });
    out = sizes.scanProject(dir, { budget, registry: reg });
  } catch (e) { fail(`size: ${e.message}`); }
  if (json) { process.stdout.write(JSON.stringify({ ...out, notes: reg.notes }, null, 2) + "\n"); return; }

  const totalGb = (out.bytes_at_least / GB).toFixed(1);
  if (out.complete) {
    process.stdout.write(`${totalGb} GB\n`);
  } else {
    process.stdout.write(`≥ ${totalGb} GB (stopped after ${out.entries_visited} entries — `
      + "the entry budget; waypost size --budget <n> to raise it)\n");
  }
  const sorted = [...out.dirs].sort((a, b) => b.bytes - a.bytes);
  if (!sorted.length) { process.stdout.write("no build artifacts found\n"); return; }
  for (const d of sorted) {
    const abs = resolve(out.root, d.path || ".");
    process.stdout.write(`  ${(d.bytes / GB).toFixed(1)} GB  ${tildeHome(abs)}${d.partial ? "  (partial)" : ""}\n`);
  }
}

// ─── clean ───────────────────────────────────────────────────────────────
//
// waypost clean [--json] — WP-17, the clean-plan story (ADR "Disk hygiene by
// discovery" Decision 4). A classified plan over both scopes at once: the
// project (walked with rootItem:false — the project root is never an item —
// and the entry budget `size` itself uses) and the machine (a fresh
// profile's own caches, plus any registry cache the profile does not carry
// yet, the same static fallback `size --global` uses without one). Every
// fact classification needs — git ignore/tracked status, the live process
// table, leases, whether another host shares this checkout — is gathered
// HERE and handed to the pure scripts/cleanup.mjs; nothing there ever
// touches the filesystem or a subprocess. Holds the machine-wide slot the
// whole time it runs, exactly like `size --global` (WP-18 Decision 4): a
// plan is itself a scan of the whole machine's caches.
//
// waypost clean --apply <id…>|should [--yes --reason "…"] — the removal
// story (Decision 5, and its amendment for the standing yes at the end of
// `run --heavy`, which does not apply here — every apply here needs its own
// yes). Removal itself lives ENTIRELY in this file: scripts/cleanup.mjs and
// scripts/sizes.mjs carry the same two guards forbidding a removal call or
// a quoted removal word, so this is the only place any of it can happen.

// WAYPOST_CLEAN_NOW overrides "now" for hermetic tests only — ctime cannot be
// backdated on a fixture, so a test instead moves the clock forward past
// stale_days. Honored only under NODE_TEST_CONTEXT — the marker `node --test`
// sets on itself and every child process it spawns (never set otherwise, and
// never something a real invocation could set by accident) — so a variable
// leaked into an interactive shell can never misdate a real plan; ignored
// with a warning on stderr instead. Warned at most once either way, the
// same way WAYPOST_CAPACITY_PROBE is (warnIfProbed above).
let warnedCleanNowProbed = false;
function cleanNow() {
  const raw = process.env.WAYPOST_CLEAN_NOW;
  if (!raw) return Date.now();
  if (!process.env.NODE_TEST_CONTEXT) {
    if (!warnedCleanNowProbed) {
      warnedCleanNowProbed = true;
      process.stderr.write("waypost: WAYPOST_CLEAN_NOW is set but NODE_TEST_CONTEXT is not — ignored (tests only)\n");
    }
    return Date.now();
  }
  const n = Number(raw);
  const ms = Number.isFinite(n) ? n : Date.parse(raw);
  if (!Number.isFinite(ms)) return Date.now();
  if (!warnedCleanNowProbed) {
    warnedCleanNowProbed = true;
    process.stderr.write("waypost: WAYPOST_CLEAN_NOW is set — the clock is not the real one (tests only)\n");
  }
  return ms;
}

// Whether a harness is running right now, checked the way the machine-wide-
// limit ADR's own gate checks it: WAYPOST_HARNESS is never trusted alone to
// say "no harness" (it could just be unset by whatever is asking) — the
// SAME detection is also run with it forced empty, so the real process
// ancestry and the registry's own env markers still have their say either
// way. Any failure along the way (the agents module itself, or the
// detection call) is read as "no harness detected" — the terminal check is
// the other half of this gate, so a session with neither a TTY nor a
// harness still needs --yes --reason regardless.
async function isHarnessDetected() {
  try {
    const agents = await import(`file://${SCRIPT("agents")}`);
    if (agents.detectHarness(process.env) !== "unknown") return true;
    if (agents.detectHarness({ ...process.env, WAYPOST_HARNESS: "" }) !== "unknown") return true;
    return false;
  } catch {
    return false;
  }
}

// Gathers every project- and machine-scope item, plus every fact
// classification needs, once — the plan, `--apply` and `setup`'s own audit
// all build from this same context, so "should" always re-plans against the
// current state rather than a stale earlier run. `budget` bounds the
// project walk the way `waypost size` itself can be bounded (`clean` stays
// unbounded, its own existing behaviour; `setup`'s audit passes
// DEFAULT_ENTRY_BUDGET, the same fixed count `doctor` uses, so it stays
// deterministic there too). `includeMachine: false` skips the machine scope
// entirely — no profile read, no cache candidates resolved — for a caller
// that already knows this run has nothing fresh to say about it (`setup`,
// when discovery did not just refresh the machine profile).
function gatherCleanContext({ cleanup, sizes, toolchains, presence, discovery }, { budget = null, includeMachine = true } = {}) {
  const root = projectRoot();
  const home = homedir();
  const stateDir = machineStateDir();
  const platform = process.platform;

  // The vault, if any — read early: a lease is stored keyed the same way
  // `presence.vaultRel` spells it (vault-relative when the leased path sits
  // inside the bound vault, project-relative otherwise), and that function
  // is one-way — resolving a lease's own string back to an absolute path
  // would be genuinely ambiguous (the same relative string can spell a real
  // path under EITHER root). Every project item is instead run through the
  // SAME vaultRel() a lease went through, and compared as strings — no
  // inversion needed either way.
  const cfg = readConfig();
  const vault = cfg && cfg.vault_path && existsSync(cfg.vault_path) ? cfg.vault_path : null;

  const reg = toolchains.loadRegistry({ projectRoot: root, platform });
  const metadataNames = sizes.metadataNamesOf(reg.entries);

  // A project root that is itself home, an ancestor of home, or a
  // filesystem/drive root can never be a project to scan — scanProject
  // itself throws for $HOME and "/" outright, and an ancestor of home is no
  // safer a target. Reusing cleanup.refusePath here (home only, no `root`/
  // `stateDir` — those would make every path trivially "refused") is the
  // same protected-path logic every item is already checked against. Plan
  // the machine scope only, rather than throwing `waypost clean` (or
  // setup's own audit) down with it — there being no project bound here is
  // an ordinary state, not a failure.
  const projectScopeRefused = cleanup.refusePath(root, { home, platform });

  // Project scope: the project root is never an item (rootItem: false); a
  // batched git check-ignore/ls-files over every match this walk found, once,
  // gives classification the ignored/tracked facts it needs per item. A
  // locator match's own `path` is already absolute (outside the project),
  // so it never enters that batch.
  let projectItems = [];
  let projectEcosystems = [];
  if (!projectScopeRefused) {
    const scan = sizes.scanProject(root, { registry: reg, rootItem: false, budget });
    const relCandidates = scan.dirs.filter((d) => d.match !== "locator").map((d) => d.path);
    const gf = sizes.gitFacts(root, relCandidates);
    projectItems = scan.dirs.map((d) => {
      const abs = d.match === "locator" ? d.path : resolve(root, d.path);
      return {
        scope: "project", path: abs, rel: d.match === "locator" ? null : d.path,
        leaseRel: vault ? presence.vaultRel(abs, vault) : abs,
        bytes: d.bytes, newest_ms: d.newest_ms, nested_git: d.nested_git,
        in_nested_repo: d.in_nested_repo, unreadable: d.unreadable, other_fs: d.other_fs, partial: d.partial, match: d.match,
        tool: d.tool, origin: d.origin, regenerable: d.regenerable, stale_days: d.stale_days,
        clean: d.clean, clean_argv: d.clean_argv, dev: d.dev, ino: d.ino,
        ignored: d.match === "locator" ? undefined : gf.ignored.has(d.path),
        tracked: d.match === "locator" ? undefined : gf.tracked.has(d.path),
      };
    });
    // The project's own detected ecosystems (scripts/discovery.mjs) — a tag
    // or generic match carries no owning tool of its own (see
    // classifyItem's projectEcosystemRunning check), so this is the only
    // in-use signal available for either kind.
    projectEcosystems = discovery.detectManifests(reg.entries, { projectRoot: root });
  }

  // Machine scope: a fresh profile's own caches (facts only — policy is
  // reattached from THIS registry, same as `size --global`), plus any
  // registry cache item the profile does not carry — measured directly, the
  // static fallback path `size --global` uses without a profile at all.
  const host = presence.hostSlug();
  const machineItems = [];
  if (includeMachine) {
    const machinePath = discovery.machineProfilePath({ home, host });
    let machine = null;
    if (existsSync(machinePath)) {
      try { machine = JSON.parse(readFileSync(machinePath, "utf8")); } catch { machine = null; }
    }
    const freshProfile = machine && machine.platform === platform
      && Array.isArray(machine.caches) && !discovery.needsRefresh(machine, {});
    const profileCaches = freshProfile ? sizes.scanGlobal({ profile: machine, registry: reg, platform }) : [];
    const covered = new Set(profileCaches.map((c) => c.path));
    const staticCandidates = sizes.cacheCandidates({ home, env: process.env, platform, registry: reg })
      .filter((c) => !covered.has(c.path));
    const extraCaches = sizes.measureCaches(staticCandidates, { metadata: metadataNames });
    // The plain env/default path of every cache item, for comparing an
    // "asked" path against — computed once, resolved with no asking at
    // all, so an asked path that merely happens to agree with the default
    // is never treated as if it had moved (see routeFor's own
    // askedNonDefault check, decided here at plan time rather than only
    // discovered later at apply time).
    const defaultOnly = toolchains.resolveCachePaths(reg.entries, { home, env: process.env, platform, ask: false });
    const defaultPathsByKey = new Map();
    for (const c of defaultOnly) {
      const key = `${c.tool}::${c.item}`;
      if (!defaultPathsByKey.has(key)) defaultPathsByKey.set(key, new Set());
      defaultPathsByKey.get(key).add(c.path);
    }
    for (const c of [...profileCaches, ...extraCaches]) {
      const key = `${c.tool}::${c.item}`;
      const askedNonDefault = c.source === "asked" && !(defaultPathsByKey.get(key) || new Set()).has(c.path);
      machineItems.push({
        scope: "machine", path: c.path, rel: null,
        // `item` (the cache's own raw path template) and `source` ("asked"
        // vs. "env"/"default") are what the removal path re-checks a moved
        // cache and an asked-only path against — see machinePathStillSafe()
        // below. `askedNonDefault` is what routeFor itself already used to
        // decide the route shown in THIS plan.
        item: c.item ?? null, source: c.source ?? null, askedNonDefault,
        bytes: c.bytes, newest_ms: c.newest_ms,
        nested_git: false, in_nested_repo: false, unreadable: c.unreadable, other_fs: c.other_fs, partial: false, match: null,
        tool: c.tool, origin: null, regenerable: c.regenerable, stale_days: c.stale_days,
        clean: c.clean, clean_argv: c.clean_argv, clean_docs: c.clean_docs ?? null, manual: c.manual, dev: c.dev, ino: c.ino,
      });
    }
  }

  // Facts outside the walk: the live process table (never on win32; null
  // either way when `ps` itself is unavailable or fails — presence.mjs's
  // own processTable() folds every such case into null, so `table === null`
  // is the one signal that means "no live process table, protection here is
  // by recent modification time only" — the plan's own inUseSignal below),
  // the other live sessions' leases on a path inside this project, and
  // whether a live session on another host shares this checkout — all
  // advisory, exactly as ADR-0007 already treats them, and all skipped
  // gracefully when there is no bound vault to read them from.
  const table = platform === "win32" ? null : presence.processTable();
  const comms = table ? [...table.values()].map((p) => p.comm).filter(Boolean) : [];
  const runningTools = cleanup.runningTools(reg.entries, comms);
  const projectEcosystemRunning = projectEcosystems.some((e) => runningTools.has(e.id));
  const inUseSignal = table ? "process-table" : "recency-only";

  let leases = [];
  let sharedProject = false;
  if (vault) {
    const sess = process.env.WAYPOST_SESSION_ID || null;
    leases = presence.readLeases(vault, { self: sess })
      .filter((l) => l.live && !l.mine)
      .map((l) => ({ path: l.path, session: l.session, host: l.host }));
    sharedProject = presence.sharedTree(vault, { self: sess }).shared;
  }

  return {
    root, home, stateDir, platform, vault, reg, metadataNames, host,
    projectItems, machineItems, runningTools, leases, sharedProject,
    projectEcosystemRunning, inUseSignal,
  };
}

function factsFrom(ctx, now) {
  return {
    now, home: ctx.home, root: ctx.root, stateDir: ctx.stateDir, platform: ctx.platform,
    runningTools: ctx.runningTools, leases: ctx.leases, sharedProject: ctx.sharedProject,
    projectEcosystemRunning: ctx.projectEcosystemRunning,
  };
}

function planFromContext(ctx, cleanup, now) {
  return cleanup.classify([...ctx.projectItems, ...ctx.machineItems], factsFrom(ctx, now), { now });
}

function formatPlanItem(it) {
  return {
    id: it.id, scope: it.scope, path: it.path, ...(it.rel ? { rel: it.rel } : {}),
    bytes: it.bytes, class: it.class, reason: it.reason, route: it.route,
    match: it.match, tool: it.tool, stale_days: it.stale_days, newest_ms: it.newest_ms,
    picked: it.picked,
    // A "can" item flagged manual has no route waypost will ever run — its
    // own clean/clean_docs are shown instead, so the plan itself carries
    // the instructions rather than only the reason it stopped there.
    ...(it.manual === true ? { manual: true } : {}),
    ...(it.clean ? { clean: it.clean } : {}),
    ...(it.clean_docs ? { clean_docs: it.clean_docs } : {}),
  };
}

function formatPlan(classified, ctx, now) {
  return {
    host: ctx.host, root: ctx.root, generated_at: new Date(now).toISOString(),
    in_use_signal: ctx.inUseSignal, items: classified.map(formatPlanItem),
  };
}

function printCleanPlan(result) {
  process.stdout.write(`host  ${result.host}\n`);
  process.stdout.write(`root  ${tildeHome(result.root)}\n`);
  if (result.in_use_signal === "recency-only") {
    process.stdout.write("(no live process table — in-use protection is by recent modification time only)\n");
  }
  let any = false;
  for (const cls of ["should", "can", "keep"]) {
    const items = result.items.filter((it) => it.class === cls).sort((a, b) => b.bytes - a.bytes);
    if (!items.length) continue;
    any = true;
    process.stdout.write(`\n${cls} (${items.length})\n`);
    for (const it of items) {
      const where = it.rel || tildeHome(it.path);
      process.stdout.write(`  ${it.id}  ${(it.bytes / GB).toFixed(2)} GB  [${it.scope}]  ${where}\n    ${it.reason}\n`);
      if (it.manual && it.clean) process.stdout.write(`    manual: ${it.clean}\n`);
    }
  }
  if (!any) process.stdout.write("\nnothing found\n");
}

// setup's own audit report: a count and a GB total per class, then the five
// largest items overall, whatever class they are in — the two things worth
// knowing before deciding whether to look further with `waypost clean`.
function printAuditSummary(classified, say, inUseSignal) {
  if (inUseSignal === "recency-only") {
    say("  (no live process table — in-use protection is by recent modification time only)");
  }
  for (const cls of ["should", "can", "keep"]) {
    const items = classified.filter((it) => it.class === cls);
    const gb = items.reduce((sum, it) => sum + (it.bytes || 0), 0) / GB;
    say(`  ${cls}  ${items.length} item(s), ${gb.toFixed(2)} GB`);
  }
  const largest = [...classified].sort((a, b) => b.bytes - a.bytes).slice(0, 5);
  if (largest.length) {
    say("  largest:");
    for (const it of largest) {
      const where = it.rel || tildeHome(it.path);
      const manualNote = it.manual && it.clean ? ` — manual: ${it.clean}` : "";
      say(`    ${(it.bytes / GB).toFixed(2)} GB  [${it.class}]  ${where}${manualNote}`);
    }
  }
}

// ─── --apply: parsing and selecting ────────────────────────────────────

// `--apply` takes a variable number of positional values (ids, or the
// single word "should") rather than the shared opt()'s one-token shape, so
// it is parsed by hand: every token right after the flag, up to the next
// one starting with "--" or the end of argv.
function parseApplySelection(args) {
  const { head } = splitAtTerminator(args);
  const i = head.indexOf("--apply");
  if (i === -1) return null;
  const values = [];
  for (let j = i + 1; j < head.length; j++) {
    if (head[j].startsWith("--")) break;
    values.push(head[j]);
  }
  if (values.length === 0) return { mode: "empty" };
  if (values.length === 1 && values[0] === "should") return { mode: "should" };
  if (values.length === 1 && values[0] === "can") return { mode: "can" };
  return { mode: "ids", ids: values };
}

function selectionDescriptorOf(sel) {
  return sel.mode === "should" ? { mode: "should" } : { mode: "ids", ids: sel.ids };
}

// Resolves a selection against the CURRENT (just-built) plan: { toApply,
// refused }. Every refusal is named up front, before anything is even
// re-checked, let alone removed:
//   - "should": every item classified should right now, whatever id it has.
//   - an id absent from the plan: gone, or never something Waypost would
//     remove at all (a symlink/junction is never followed, so it never
//     became an item in the first place).
//   - a manual machine cache: refused, showing its own prose `clean` text —
//     manual items are never run, by id or otherwise.
//   - a keep item: refused with the plan's own reason.
//   - anything else (should or can, not manual): eligible — "can only by
//     id" is enforced by --apply can itself being refused outright, not
//     here.
function resolveApplySelection(classified, sel) {
  if (sel.mode === "should") {
    return { toApply: classified.filter((it) => it.class === "should"), refused: [] };
  }
  const byId = new Map(classified.map((it) => [it.id, it]));
  const toApply = [];
  const refused = [];
  for (const id of sel.ids) {
    const it = byId.get(id);
    if (!it) {
      refused.push({
        id, path: null, scope: null, bytes: null, class: null, route: null,
        reason: "not in the plan now: gone, or no longer a directory Waypost would remove — a symbolic link is never followed",
      });
      continue;
    }
    if (it.manual) {
      refused.push({ id, path: it.path, scope: it.scope, bytes: it.bytes, class: it.class, route: null, reason: it.clean || "manual — see its own instructions, never run automatically" });
      continue;
    }
    if (it.class === "keep") {
      refused.push({ id, path: it.path, scope: it.scope, bytes: it.bytes, class: it.class, route: it.route, reason: it.reason });
      continue;
    }
    toApply.push(it);
  }
  return { toApply, refused };
}

// Ancestors before descendants: sorted by path depth, so a directory chosen
// alongside one of its own subdirectories (a project and a machine item can
// coincide in principle) is always removed before whatever sits inside it.
function orderForRemoval(items) {
  return [...items].sort((a, b) => {
    const da = a.path.split(sep).length, db = b.path.split(sep).length;
    return da !== db ? da - db : (a.path < b.path ? -1 : a.path > b.path ? 1 : 0);
  });
}

function isDescendantOf(p, ancestor) {
  return p !== ancestor && p.startsWith(ancestor + sep);
}

// ─── recheck, right before touching anything ───────────────────────────

// Fresh facts for exactly one item: inspectDir for its own bytes/age/nested-
// repo/readability, gitFacts scoped to just this one path (project items
// only — a locator match lives outside the project, so its git status is
// not this repository's to answer), the live process table, leases and
// sharedTree — all re-read, never carried over from the plan.
function freshFactsFor(item, ctx, mods, now) {
  const { sizes, cleanup, presence } = mods;
  const inspected = sizes.inspectDir(item.path, { metadata: ctx.metadataNames });
  let ignored, tracked;
  if (item.scope === "project" && item.match !== "locator" && inspected.exists && inspected.is_directory) {
    const rel = relative(ctx.root, item.path);
    const gf = sizes.gitFacts(ctx.root, [rel]);
    ignored = gf.ignored.has(rel);
    tracked = gf.tracked.has(rel);
  }
  const table = ctx.platform === "win32" ? null : presence.processTable();
  const comms = table ? [...table.values()].map((p) => p.comm).filter(Boolean) : [];
  const runningTools = cleanup.runningTools(ctx.reg.entries, comms);
  let leases = [];
  let sharedProject = false;
  if (ctx.vault) {
    const sess = process.env.WAYPOST_SESSION_ID || null;
    leases = presence.readLeases(ctx.vault, { self: sess }).filter((l) => l.live && !l.mine)
      .map((l) => ({ path: l.path, session: l.session, host: l.host }));
    sharedProject = presence.sharedTree(ctx.vault, { self: sess }).shared;
  }
  const fresh = { ...inspected, ...(ignored !== undefined ? { ignored } : {}), ...(tracked !== undefined ? { tracked } : {}) };
  return { fresh, facts: factsFrom({ ...ctx, runningTools, leases, sharedProject }, now) };
}

function recheckItem(item, ctx, mods, now) {
  const { fresh, facts } = freshFactsFor(item, ctx, mods, now);
  return { ...mods.cleanup.recheck(item, fresh, facts), fresh };
}

function findCacheDef(reg, toolId, itemKey) {
  if (!toolId || !itemKey) return null;
  const entry = reg.entries.find((e) => e.id === toolId);
  if (!entry) return null;
  return (entry.caches || []).find((c) => c.path === itemKey) || null;
}

// A machine cache's own path re-checked right before removing it: when the
// shipped entry has an `ask` AND the route about to run is the tool's own
// clean_argv, the tool is asked again, and a path it no longer reports is
// skipped rather than removed from under a moved cache. Re-asking is scoped
// to a clean_argv route specifically — that is the one route that hands off
// to the TOOL itself, so it is the one place it matters whether the tool
// would now target somewhere else; a waypost-remove route never runs the
// tool at all, and (per routeFor, scripts/cleanup.mjs, decided already at
// plan time via `askedNonDefault`) is only ever given to a path already
// known to match its own default resolution.
function machinePathStillSafe(item, ctx, mods, route) {
  if (item.scope !== "machine") return { ok: true };
  if (route && route.kind === "tool-clean-argv") {
    const def = findCacheDef(ctx.reg, item.tool, item.item);
    if (def && def.ask && Array.isArray(def.ask.argv) && def.ask.argv.length) {
      const bin = mods.discovery.findOnPath(def.ask.argv[0], { platform: ctx.platform, env: process.env });
      if (bin) {
        let asked;
        try { asked = mods.toolchains.askCache(def.ask, { bin, env: process.env, home: ctx.home, platform: ctx.platform }); }
        catch { asked = { ok: false }; }
        if (asked.ok && !asked.value.includes(item.path)) {
          return { ok: false, reason: "the tool now reports a different cache location — re-plan with `waypost clean`" };
        }
      }
    }
  }
  // Defense in depth: routeFor itself already refuses a waypost-remove
  // route for an asked path whose plan-time askedNonDefault was true —
  // recheck() never changes that field, so this only ever re-states the
  // same refusal the plan already made, never a route that reached here.
  if (item.source === "asked" && item.askedNonDefault === true && route && route.kind === "waypost-remove") {
    return { ok: false, reason: "an asked (non-default) cache path is removed only through its own clean_argv" };
  }
  return { ok: true };
}

// ─── the routes themselves — the only removal calls in this whole tree ──

// `git clean -X` over a 35 GB target/, or `go clean -modcache` over a large
// module cache, can run for minutes — long enough that a short timeout would
// kill the process mid-removal and leave a half-deleted tree, reported as a
// clean "failed" with nothing actually verified. 30 minutes, the same order
// of magnitude `waypost run --heavy`'s own long jobs already run under,
// while still holding this command's own machine-wide slot the whole time.
const REMOVE_TIMEOUT_MS = 30 * 60 * 1000;

function removeItem(item, route, ctx, mods) {
  if (route.kind === "waypost-remove") {
    rmSync(item.path, { recursive: true });
    return;
  }
  if (route.kind === "git-clean-x") {
    const rel = relative(ctx.root, item.path);
    const r = spawnSync("git", ["--literal-pathspecs", "-C", ctx.root, "clean", "-X", "-d", "-f", "--", rel],
      { encoding: "utf8", timeout: REMOVE_TIMEOUT_MS });
    if (r.error) throw r.error;
    if (r.status !== 0) throw new Error(`git clean exited ${r.status}: ${(r.stderr || "").trim().slice(0, 300)}`);
    return;
  }
  if (route.kind === "tool-clean-argv") {
    const bin = mods.discovery.findOnPath(route.argv[0], { platform: ctx.platform, env: process.env });
    if (!bin) throw new Error(`${route.argv[0]} not found on PATH`);
    if (ctx.platform === "win32" && mods.toolchains.BATCH_SHIM_RE.test(bin)) {
      throw new Error(`${route.argv[0]} is a .cmd/.bat shim — refused, the same as asking it`);
    }
    // Project: the manifest directory (the item's own parent) — a tool's
    // project-clean command runs the way it would from a checkout. Machine:
    // home, the same cwd asking it already uses.
    const cwd = item.scope === "project" ? dirname(item.path) : ctx.home;
    const r = spawnSync(bin, route.argv.slice(1), { shell: false, stdio: ["ignore", "pipe", "pipe"], cwd, timeout: REMOVE_TIMEOUT_MS, encoding: "utf8" });
    if (r.error) throw r.error;
    if (r.status !== 0) throw new Error(`${route.argv[0]} exited ${r.status}: ${(r.stderr || "").trim().slice(0, 300)}`);
    return;
  }
  throw new Error("no route");
}

// What a partial git-clean-x left behind, best effort — never blocks the
// result itself if either read fails.
function describeKept(item, ctx, mods) {
  const parts = [];
  let inspected = null;
  try { inspected = mods.sizes.inspectDir(item.path, {}); } catch { /* best effort */ }
  if (inspected && inspected.nested_git) parts.push("a nested repository");
  try {
    const rel = relative(ctx.root, item.path);
    const gf = mods.sizes.gitFacts(ctx.root, [rel]);
    if (gf.tracked.has(rel)) parts.push("tracked file(s)");
  } catch { /* best effort */ }
  return parts.length ? parts.join(" and ") : "some content";
}

// lstat ENOENT is the only "removed" verdict; anything else that still
// exists but reads smaller than it did right before the route ran is
// "partial" — a real success for git-clean-x, which by design never removes
// a tracked file or a nested repository even when this module's own
// pre-checks somehow missed one. Anything else is "failed".
function verifyRemoval(item, ctx, mods, beforeBytes) {
  let st;
  try { st = lstatSync(item.path); }
  catch (e) {
    if (e.code === "ENOENT") return { result: "removed", freed_bytes: Number.isFinite(beforeBytes) ? beforeBytes : 0 };
    return { result: "failed", freed_bytes: 0, reason: `could not verify: ${e.message}` };
  }
  let after = null;
  try { after = mods.sizes.inspectDir(item.path, { metadata: ctx.metadataNames }); } catch { /* leaves after null */ }
  if (after && after.exists && Number.isFinite(after.bytes) && Number.isFinite(beforeBytes) && after.bytes < beforeBytes) {
    return { result: "partial", freed_bytes: beforeBytes - after.bytes, kept: describeKept(item, ctx, mods) };
  }
  return { result: "failed", freed_bytes: 0, reason: "still there after the route ran" };
}

// ─── consent, the log, and the apply loop itself ───────────────────────

const APFS_FREE_SPACE_NOTE = "free space is read with fs.statfsSync; bavail excludes APFS purgeable space, so freed space can read smaller than what was actually removed";

function appendCleanLog(host, line) {
  const dir = machineStateDir();
  mkdirSync(dir, { recursive: true });
  appendFileSync(join(dir, `cleanup.${host}.jsonl`), line + "\n", "utf8");
}

function baseLogItem(item) {
  return { id: item.id, scope: item.scope, path: item.path, bytes: item.bytes, class: item.class, route: item.route };
}

function refusedLogItem(r) {
  return { id: r.id, scope: r.scope, path: r.path, bytes: r.bytes, class: r.class, route: r.route, result: "refused", reason: r.reason, freed_bytes: 0, kept: null };
}

function printApplyPreview(items) {
  const total = items.reduce((s, it) => s + (it.bytes || 0), 0);
  process.stderr.write(`About to remove ${items.length} item(s), ${(total / GB).toFixed(2)} GB total:\n`);
  for (const it of items) process.stderr.write(`  ${it.id}  ${(it.bytes / GB).toFixed(2)} GB  ${it.path}\n`);
}

function groupByDev(ordered) {
  const groups = new Map();
  ordered.forEach((item, idx) => {
    const key = item.dev ?? "unknown";
    if (!groups.has(key)) groups.set(key, { dev: item.dev ?? null, path: dirname(item.path), firstIndex: idx, lastIndex: idx });
    else groups.get(key).lastIndex = idx;
  });
  return groups;
}

// `source` and `prebuilt` let a caller other than `clean` itself (`setup`'s
// own audit step) reuse this whole removal path: `source` tags the log line
// ("setup" instead of "clean"), and `prebuilt` — an already-built
// `{ ctx, classified }`, from the SAME gatherCleanContext/planFromContext
// this function would otherwise call — skips a second, redundant scan when
// the caller already built one (setup's own report needs it anyway).
async function applyClean(sel, consent, mods, now, { source = "clean", prebuilt = null } = {}) {
  const { cleanup, presence } = mods;
  const root = projectRoot();
  const host = presence.hostSlug();
  const selection = selectionDescriptorOf(sel);

  const logAndReturn = (yesField, items, exitCode) => {
    const line = cleanup.logLine({
      at: new Date(now).toISOString(), host, session: process.env.WAYPOST_SESSION_ID || null,
      harness: process.env.WAYPOST_HARNESS || null, source, root,
      clock: process.env.WAYPOST_CLEAN_NOW || null,
      yes: yesField, selection, items, filesystems: [], exit: exitCode,
    });
    appendCleanLog(host, line);
    return exitCode;
  };

  // Build the plan fresh, right now, unless the caller already did: "should"
  // re-plans against the current state; an id is looked up against this
  // same fresh plan, never a stale earlier one.
  const ctx = prebuilt ? prebuilt.ctx : gatherCleanContext(mods);
  const classified = prebuilt ? prebuilt.classified : planFromContext(ctx, cleanup, now);
  const { toApply, refused } = resolveApplySelection(classified, sel);

  if (consent.method === "prompt" && toApply.length) {
    printApplyPreview(toApply);
    const answered = await askYesNo(`Remove ${toApply.length} item(s)? [y/N] `, { timeoutMs: 60000 });
    if (!answered) {
      const items = [...refused.map(refusedLogItem), ...toApply.map((it) => ({ ...baseLogItem(it), result: "declined", reason: "not confirmed", freed_bytes: 0, kept: null }))];
      const exitCode = logAndReturn({ by: null, declined: true }, items, 1);
      return { exitCode, declined: true, message: "not confirmed — nothing removed" };
    }
  }

  // ── remove, ancestors first, filesystem free space measured per device ──
  const ordered = orderForRemoval(toApply);
  const devGroups = groupByDev(ordered);
  const fsStats = new Map();
  const removedRoots = [];
  const results = [];

  for (let i = 0; i < ordered.length; i++) {
    const item = ordered[i];
    const groupKey = item.dev ?? "unknown";
    const group = devGroups.get(groupKey);
    if (i === group.firstIndex) {
      try {
        const s = statfsSync(group.path);
        fsStats.set(groupKey, { dev: group.dev, path: group.path, free_before: s.bavail * s.bsize, free_after: null });
      } catch { /* best effort — this filesystem's free space just is not reported */ }
    }

    const ancestor = removedRoots.find((r) => isDescendantOf(item.path, r.path));
    if (ancestor) {
      results.push({ ...baseLogItem(item), result: "removed", reason: `removed with ${ancestor.id}`, freed_bytes: 0, kept: null });
    } else {
      try {
        const rc = recheckItem(item, ctx, mods, now);
        const stillEligible = sel.mode === "should" ? rc.class === "should" : rc.class !== "keep";
        if (rc.changed || !stillEligible || !rc.route) {
          results.push({ ...baseLogItem(item), result: "skipped", reason: rc.reason, freed_bytes: 0, kept: null });
        } else {
          const safe = machinePathStillSafe(item, ctx, mods, rc.route);
          if (!safe.ok) {
            results.push({ ...baseLogItem(item), result: "skipped", reason: safe.reason, freed_bytes: 0, kept: null });
          } else {
            const beforeBytes = Number.isFinite(rc.fresh.bytes) ? rc.fresh.bytes : item.bytes;
            try {
              removeItem(item, rc.route, ctx, mods);
              const v = verifyRemoval(item, ctx, mods, beforeBytes);
              results.push({ ...baseLogItem(item), result: v.result, reason: v.reason || null, freed_bytes: v.freed_bytes, kept: v.kept || null });
              if (v.result === "removed") removedRoots.push({ path: item.path, id: item.id });
            } catch (e) {
              // A route that threw (a timeout on a huge tree, in
              // particular) may still have removed real content before it
              // did — re-measure best effort so a killed-mid-removal
              // `git clean -X` is reported with the bytes it actually
              // freed, not a flat 0 that hides gigabytes of real progress.
              let freedBytes = 0;
              let reason = e.message;
              try {
                const after = mods.sizes.inspectDir(item.path, { metadata: ctx.metadataNames });
                if (!after || after.exists === false) {
                  freedBytes = Number.isFinite(beforeBytes) ? beforeBytes : 0;
                } else if (after.exists && Number.isFinite(after.bytes) && Number.isFinite(beforeBytes) && after.bytes < beforeBytes) {
                  freedBytes = beforeBytes - after.bytes;
                  reason = `${e.message} (partial — some content was removed before this failed)`;
                }
              } catch { /* best effort — report the error alone */ }
              results.push({ ...baseLogItem(item), result: "failed", reason, freed_bytes: freedBytes, kept: null });
            }
          }
        }
      } catch (e) {
        results.push({ ...baseLogItem(item), result: "failed", reason: e.message, freed_bytes: 0, kept: null });
      }
    }

    if (i === group.lastIndex) {
      const rec = fsStats.get(groupKey);
      if (rec) { try { const s = statfsSync(group.path); rec.free_after = s.bavail * s.bsize; } catch { /* best effort */ } }
    }
  }

  const filesystems = [...fsStats.values()].map((r) => ({
    dev: r.dev, path: r.path, free_before: r.free_before, free_after: r.free_after,
    freed: (r.free_after != null && r.free_before != null) ? r.free_after - r.free_before : null,
  }));

  const allItems = [...refused.map(refusedLogItem), ...results];
  const exitCode = (refused.length === 0 && results.every((r) => r.result === "removed" || r.result === "partial")) ? 0 : 1;
  const yesField = consent.method === "flag" ? { by: "flags", reason: consent.reason } : { by: "terminal" };

  const line = cleanup.logLine({
    at: new Date(now).toISOString(), host, session: process.env.WAYPOST_SESSION_ID || null,
    harness: process.env.WAYPOST_HARNESS || null, source, root,
    clock: process.env.WAYPOST_CLEAN_NOW || null,
    yes: yesField, selection, items: allItems, filesystems, exit: exitCode,
  });
  // The report above is real work already done (removals, verified,
  // measured) — a failure writing ITS log line (ENOSPC, a read-only state
  // dir) must never throw this away. Caught here, surfaced as its own
  // field, and forced non-zero: the caller still sees exactly what
  // happened to every item, plus the one thing that did not get recorded.
  let logError = null;
  try { appendCleanLog(host, line); } catch (e) { logError = e.message; }

  return {
    exitCode: logError ? 1 : exitCode, host, root, selection, items: allItems, filesystems,
    apfs_note: APFS_FREE_SPACE_NOTE, ...(logError ? { log_error: logError } : {}),
  };
}

function printApplyResult(result) {
  // A consent refusal (no valid --yes --reason, no eligible terminal) is
  // handled directly in handleClean, before this is ever reached — only a
  // declined interactive prompt (the plan was already built to show it)
  // takes this early return here.
  if (result.declined) {
    process.stderr.write(`waypost clean --apply: ${result.message}\n`);
    return;
  }
  for (const it of result.items) {
    const where = it.path ? tildeHome(it.path) : (it.id || "?");
    process.stdout.write(`  ${it.id || "?"}  ${it.result}  ${where}\n`);
    if (it.reason) process.stdout.write(`    ${it.reason}\n`);
    if (it.kept) process.stdout.write(`    kept: ${it.kept}\n`);
  }
  for (const fsEntry of result.filesystems) {
    if (fsEntry.freed == null) continue;
    process.stdout.write(`  ${tildeHome(fsEntry.path)}: ${(fsEntry.freed / GB).toFixed(2)} GB freed\n`);
  }
  if (result.filesystems.length) process.stdout.write(`  (${result.apfs_note})\n`);
  if (result.log_error) process.stdout.write(`  log not written: ${result.log_error}\n`);
  process.stdout.write(result.exitCode === 0 ? "done\n" : "done, with issues — see above\n");
}

async function handleClean(args) {
  const json = flag(args, "--json");
  const applySel = parseApplySelection(args);
  if (applySel && applySel.mode === "empty") { fail("clean --apply: needs an id, a list of ids, or should"); return; }
  if (applySel && applySel.mode === "can") { fail("clean --apply can: refused — can items are removed only by id"); return; }

  let cleanup, sizes, toolchains, capacity, presence, discovery;
  try {
    cleanup = await import(`file://${SCRIPT("cleanup")}`);
    sizes = await import(`file://${SCRIPT("sizes")}`);
    toolchains = await import(`file://${SCRIPT("toolchains")}`);
    capacity = await import(`file://${SCRIPT("capacity")}`);
    presence = await import(`file://${SCRIPT("presence")}`);
    discovery = await import(`file://${SCRIPT("discovery")}`);
  } catch (e) { fail(`clean: ${e.message}`); }

  const now = cleanNow();

  // --apply's consent is decided before the machine-wide slot is ever
  // claimed: a harness detected, or no terminal and no --yes --reason, must
  // refuse the SAME way whether or not the machine happens to be busy with
  // something else entirely — claiming a slot first would make that refusal
  // depend on machine load, and waste a slot on a request that was always
  // going to be refused.
  let consentDecision = null;
  if (applySel) {
    const yes = flag(args, "--yes");
    const reasonFlag = opt(args, "--reason");
    const isTTY = Boolean(process.stdin.isTTY);
    const harnessDetected = await isHarnessDetected();
    consentDecision = cleanup.consent({ yes, reason: reasonFlag, isTTY, harnessDetected });
    if (consentDecision.method === "refused") {
      const host = presence.hostSlug();
      const root = projectRoot();
      const line = cleanup.logLine({
        at: new Date(now).toISOString(), host, session: process.env.WAYPOST_SESSION_ID || null,
        harness: process.env.WAYPOST_HARNESS || null, source: "clean", root,
        clock: process.env.WAYPOST_CLEAN_NOW || null,
        yes: { by: null, declined: false }, selection: selectionDescriptorOf(applySel), items: [], filesystems: [], exit: 1,
      });
      appendCleanLog(host, line);
      const message = `${consentDecision.reason} — pass --yes --reason "<who agreed, when>" or run \`waypost prompt cleanup\``;
      if (json) process.stdout.write(JSON.stringify({ exitCode: 1, refusedEarly: true, message }, null, 2) + "\n");
      else process.stderr.write(`waypost clean --apply: ${message}\n`);
      process.exitCode = 1;
      return;
    }
  }

  // Same rule as `size --global` (WP-18 Decision 4): a machine-wide scan
  // holds the machine-wide slot, same refusal (exit 75), for the plan AND
  // for --apply. No fail() between the claim and the finally below, so the
  // slot is always released.
  const dir = slotsDir(presence);
  mkdirSync(dir, { recursive: true });
  const claim = await claimSlot(dir, ["waypost", "clean", ...(applySel ? ["--apply"] : []), ...(json ? ["--json"] : [])], capacity, presence);
  if (!claim.ok) {
    process.stderr.write(`waypost clean: refused — ${claim.reason}\n  retry: waypost clean\n`);
    process.exitCode = EX_TEMPFAIL;
    return;
  }
  recordAuthority(claim.file, capacity);

  const mods = { cleanup, sizes, toolchains, presence, discovery };
  let result, error, applyResult = false;
  try {
    if (!applySel) {
      const ctx = gatherCleanContext(mods);
      const classified = planFromContext(ctx, cleanup, now);
      result = formatPlan(classified, ctx, now);
    } else {
      applyResult = true;
      result = await applyClean(applySel, consentDecision, mods, now);
    }
  } catch (e) {
    error = e;
  } finally {
    claim.release();
  }
  if (error) fail(`clean: ${error.message}`);

  if (applyResult) {
    if (json) process.stdout.write(JSON.stringify(result, null, 2) + "\n");
    else printApplyResult(result);
    if (result.exitCode) process.exitCode = result.exitCode;
    return;
  }

  if (json) { process.stdout.write(JSON.stringify(result, null, 2) + "\n"); return; }
  printCleanPlan(result);
}

// ─── capacity ──────────────────────────────────────────────────────────
//
// waypost capacity [--json] — Decision 1 of the heavy-work-sized-to-the-
// machine ADR (WP-18): measure the machine's real free resources now, never
// cached, and say how many more heavy jobs it can take. Reaches
// scripts/capacity.mjs the way handleSize reaches sizes.mjs: a dynamic
// import(), in-process, no subprocess.
async function handleCapacity(args) {
  let capacity, presence;
  try {
    capacity = await import(`file://${SCRIPT("capacity")}`);
    presence = await import(`file://${SCRIPT("presence")}`);
  } catch (e) { fail(`capacity: ${e.message}`); }

  const releaseId = opt(args, "--release");
  if (releaseId != null) {
    await handleCapacityRelease(capacity, presence, releaseId, flag(args, "--force"), flag(args, "--json"));
    return;
  }

  const dir = slotsDir(presence);
  let holders;
  try { holders = capacity.readHolders({ dir, authority: bootAuthority(capacity) }); }
  catch { holders = { live: [], stale: [] }; }

  let m;
  try {
    m = await capacity.measure({ holders: holders.live, env: process.env });
  } catch (e) { fail(`capacity: ${e.message}`); }
  warnIfProbed(m);

  if (flag(args, "--json")) {
    process.stdout.write(JSON.stringify({ ...m, holders_live: holders.live.map(holderSummary) }, null, 2) + "\n");
    return;
  }

  const availGb = (m.memory.available / GB).toFixed(1);
  const totalGb = (m.memory.total / GB).toFixed(1);
  process.stdout.write(`${m.cores} cores, load ${m.busy.toFixed(2)}; ${availGb} of ${totalGb} GB available (${m.probes.memory})\n`);
  if (m.can_start > 0) {
    process.stdout.write(`can start ${m.can_start} heavy job${m.can_start === 1 ? "" : "s"}\n`);
  } else {
    process.stdout.write(`can start 0 — ${m.reason}\n`);
  }
  if (holders.live.length) {
    process.stdout.write("\nholders:\n");
    for (const h of holders.live) process.stdout.write(`  ${holderLine(h)}\n`);
  }
}

function holderSummary(h) {
  return { id: h.id, session: h.session, harness: h.harness, command: h.command, since: h.started_at, host: h.host };
}

function holderLine(h) {
  return `${h.id}  ${h.session || "?"} (${h.harness || "?"})  ${h.command || ""}  since ${h.started_at}`;
}

// waypost capacity --release <id> [--force]: the recovery path when a slot
// looks stuck. slotLive() runs first — the same check readHolders() uses —
// and a record that still looks alive is refused without --force.
async function handleCapacityRelease(capacity, presence, id, force, json) {
  // An id names a record in the slot directory and nothing else: no path
  // separator and no dot, so --release can never reach a file outside it.
  if (!/^[A-Za-z0-9_-]+$/.test(String(id))) fail(`capacity --release: "${id}" is not a slot id`);
  const dir = slotsDir(presence);
  const file = join(dir, `${id}.json`);
  if (!existsSync(file)) fail(`capacity --release: no such holder "${id}"`);
  let rec;
  try { rec = JSON.parse(readFileSync(file, "utf8")); }
  catch (e) { fail(`capacity --release: ${file}: ${e.message}`); }
  if (!rec || rec.id !== id || !rec.proc) fail(`capacity --release: ${file} is not a slot record for "${id}"`);
  const live = capacity.slotLive(rec, { authority: bootAuthority(capacity) });
  if (live && !force) {
    fail(`capacity --release: ${id} still looks alive (${rec.session || "?"} on ${rec.host}, pid ${rec.proc && rec.proc.pid}) — pass --force to release it anyway`);
  }
  try { unlinkSync(file); } catch (e) { fail(`capacity --release: ${e.message}`); }
  if (json) {
    process.stdout.write(JSON.stringify({ released: id, was_live: live, forced: live && force, record: holderSummary(rec) }, null, 2) + "\n");
  } else {
    process.stdout.write(`released ${holderLine(rec)}${live ? "  (forced, was still alive)" : ""}\n`);
  }
}

// ─── run --heavy: a machine-wide slot for heavy work ────────────────────
//
// WP-18 Decision 2. One slot table per machine, in the machine state
// directory (never synced): <machineStateDir()>/slots.<hostSlug>/. Every
// session, harness and project on this machine shares it. All writes to it —
// the lock, a new record, pruning a stale one — live here; scripts/capacity.mjs
// (readHolders, slotLive, bootIdentity) only ever reads it.
function slotsDir(presence) {
  return join(machineStateDir(), `slots.${presence.hostSlug()}`);
}

const EX_TEMPFAIL = 75; // sysexits.h: temporary failure, safe to retry
const LOCK_STALE_MS = 5 * 60 * 1000;
const LOCK_RETRY_BUDGET_MS = 2000;
const LOCK_RETRY_DELAY_MS = 250;
const WAIT_POLL_MS = 5000;
const REASON_PRINT_MS = 30_000;

function delay(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

// WAYPOST_CAPACITY_PROBE replaces the machine's real measures, for hermetic
// tests only. When it is honoured, say so on stderr, so a variable leaked
// into an interactive shell cannot silently fake an idle machine.
function warnIfProbed(m) {
  if (warnIfProbed.done || !m || !m.probes || m.probes.memory !== "WAYPOST_CAPACITY_PROBE") return;
  warnIfProbed.done = true;
  process.stderr.write("waypost: WAYPOST_CAPACITY_PROBE is set — the real machine is not being measured (tests only)\n");
}

// The boot authority (WP-18 amendment) is read at most once per `waypost`
// invocation, and only when something actually needs it: an epoch that
// disagrees. The claim, the lock and `--release` all share this one thunk, so
// a command that reads twenty records still spawns at most one PowerShell.
let BOOT_AUTHORITY = null;
function bootAuthority(capacity) {
  if (!BOOT_AUTHORITY) BOOT_AUTHORITY = capacity.authorityOnce();
  return BOOT_AUTHORITY;
}

// Is the lock's owner gone? The same evidence slotLive() uses for a slot
// record: the boot identity first, then on POSIX the process table and start
// time (a reused pid is not mistaken for the owner), on win32 signal-0. The
// 24-hour part is left out, since a five-minute mtime already bounds a lock.
function lockOwnerGone(owner, presence, table, capacity) {
  if (!owner || !owner.pid) return true;
  // An owner from an earlier boot is gone whatever its pid names now, so a
  // pid reused after an unclean restart never holds the lock for five minutes.
  // On the epoch path that identity drifts across a host suspend, and here
  // being wrong breaks a live claimant's lock — two processes in the critical
  // section — so a mismatch has to be confirmed before it counts as death.
  if (owner.boot && capacity) {
    const bootNow = capacity.bootIdentity();
    if (!capacity.sameBoot(owner.boot, bootNow)) {
      const drifting = owner.boot.kind === "epoch" && bootNow.kind === "epoch";
      if (!drifting) return true;
      // uptime settles "another boot" for free; nothing here may spawn, so an
      // owner uptime cannot settle is KEPT, and the lock's own five-minute
      // mtime cap is what bounds that. Breaking a live claimant's lock puts
      // two processes in the critical section: the worst thing this can get
      // wrong (WP-18, second and third amendments).
      if (capacity.uptimeSaysOtherBoot(owner, osUptime())) return true;
    }
  }
  if (process.platform === "win32") {
    try { process.kill(owner.pid, 0); return false; }
    catch (e) { return e.code === "ESRCH"; }
  }
  const rec = { host: hostname().split(".")[0], proc: { pid: owner.pid, started: owner.started || null, ticks: owner.ticks ?? null } };
  const gone = presence.processGone(rec, table);
  if (gone !== null) return gone;
  try { process.kill(owner.pid, 0); return false; }
  catch (e) { return e.code === "ESRCH"; }
}

// Broken only when its owner is dead, or the lock itself is older than five
// minutes — either reason alone is enough to reclaim it. A briefly unreadable
// owner.json (the sliver of time between the owner's own mkdirSync and its
// writeFileSync) is NOT evidence of death: treating it as such let a second
// claimant "break" a lock its rightful owner had just created, defeating
// mutual exclusion (caught by the stress test). Only a successfully read and
// confirmed-dead owner, or the five-minute mtime cap, may break it early.
function breakStaleLock(lockDir, presence, table, capacity) {
  let st;
  try { st = statSync(lockDir); } catch { return true; } // already gone
  if (Date.now() - st.mtimeMs > LOCK_STALE_MS) {
    try { rmSync(lockDir, { recursive: true, force: true }); } catch { return false; }
    return true;
  }
  let owner = null;
  try { owner = JSON.parse(readFileSync(join(lockDir, "owner.json"), "utf8")); } catch {}
  if (!owner || !lockOwnerGone(owner, presence, table, capacity)) return false;
  try { rmSync(lockDir, { recursive: true, force: true }); } catch { return false; }
  return true;
}

// mkdirSync is atomic on every OS: EEXIST means someone else holds it right
// now. Retried a few times within about 2 seconds, breaking it along the way
// per breakStaleLock(); null when the budget runs out (report busy).
async function acquireLock(dir, presence, capacity) {
  const lockDir = join(dir, ".lock");
  const deadline = Date.now() + LOCK_RETRY_BUDGET_MS;
  for (;;) {
    try {
      mkdirSync(lockDir);
      const table = process.platform === "win32" ? null : presence.processTable();
      const self = table ? table.get(process.pid) : null;
      writeFileSync(join(lockDir, "owner.json"),
        JSON.stringify({
          pid: process.pid, started: self ? self.started : null, ticks: presence.startTicks(process.pid),
          boot: capacity ? capacity.bootIdentity() : null,
          // uptime and nothing that spawns: this runs INSIDE the lock, where
          // the other claimants are waiting on a two-second budget.
          uptime: osUptime(),
        }) + "\n", "utf8");
      return lockDir;
    } catch (e) {
      if (e.code !== "EEXIST") throw e;
      const table = process.platform === "win32" ? null : presence.processTable();
      if (breakStaleLock(lockDir, presence, table, capacity)) continue; // reclaimed — retry the mkdir at once
      if (Date.now() >= deadline) return null;
      await delay(LOCK_RETRY_DELAY_MS);
    }
  }
}

function releaseLock(lockDir) {
  try { rmSync(lockDir, { recursive: true, force: true }); } catch {}
}

// Under the lock: prune the stale records, measure with the live ones, and
// either write our own record or report why not. Two processes starting in
// the same second cannot both pass the cap.
async function claimSlot(dir, argv, capacity, presence) {
  const lockDir = await acquireLock(dir, presence, capacity);
  if (!lockDir) {
    return { ok: false, reason: "the slot lock is busy — another `waypost run --heavy` is claiming right now" };
  }
  try {
    const holders = capacity.readHolders({ dir, authority: bootAuthority(capacity) });
    for (const rec of holders.stale) { try { unlinkSync(rec.file); } catch {} }
    const m = await capacity.measure({ holders: holders.live, env: process.env });
    warnIfProbed(m);
    if (m.can_start <= 0) return { ok: false, reason: m.reason || "no heavy job slot available" };

    const table = process.platform === "win32" ? null : presence.processTable();
    const self = table ? table.get(process.pid) : null;
    const id = `${process.pid}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
    const rec = {
      id,
      host: hostname().split(".")[0],
      proc: { pid: process.pid, started: self ? self.started : null, ticks: presence.startTicks(process.pid), comm: basename(process.execPath) },
      boot: capacity.bootIdentity(),
      // What an epoch mismatch is checked against later (WP-18 amendment):
      // the epoch in `boot` is itself drifted once the machine has slept, so
      // comparing THAT against a true boot time would delete live records.
      // null where the platform has no authority — such a record can then
      // only ever be kept, never pruned, which is the safe half.
      // The uptime at claim: a later reading below it confirms another boot
      // with no spawn at all (second amendment). Free on every platform.
      uptime: osUptime(),
      // Filled in by recordAuthority() once the lock is released (third
      // amendment): reading it here cost a refusal 2486 ms against a 2000 ms
      // budget, came back null under load anyway, and moved the timings enough
      // that a claim slipped past a live lock owner in the suite.
      authority: null,
      session: process.env.WAYPOST_SESSION_ID || null,
      harness: process.env.WAYPOST_HARNESS || null,
      command: argv.map(shellQuote).join(" "),
      started_at: new Date().toISOString(),
    };
    const file = join(dir, `${id}.json`);
    writeFileSync(file, JSON.stringify(rec, null, 2) + "\n", "utf8");
    return { ok: true, file, release: () => { try { unlinkSync(file); } catch {} } };
  } finally {
    releaseLock(lockDir);
  }
}

// The authority is read AFTER the slot is claimed and the lock released, and
// its answer is written into the record we already own. Not before: a refusal
// must stay immediate (Decision 2's "exits at once", and the test that pins it
// under two seconds), and a spawn inside the lock serialises the other
// claimants. Atomically, because a reader that finds a half-written record
// skips it, and a skipped record is an unheld slot. No answer is not a
// failure: uptime carries the common case on its own (WP-18, third
// amendment).
function recordAuthority(file, capacity) {
  let asked;
  // Its own patient read, not the report path's memo: this is the one place
  // whose answer every later decision about this record depends on, and the
  // only cost of waiting is the start of a job that will run for minutes.
  try { asked = capacity.bootAuthority({ timeoutMs: capacity.AUTHORITY_WRITE_TIMEOUT_MS }); } catch { return; }
  if (!asked || !file) return;
  let rec;
  try { rec = JSON.parse(readFileSync(file, "utf8")); } catch { return; }
  if (!rec || rec.authority) return;
  try { writeFileAtomic(file, JSON.stringify({ ...rec, authority: asked }, null, 2) + "\n"); } catch {}
}

// <N>s or <N>m only, the ADR's own examples (30s, 10m) — anything else fails
// fast rather than guessing.
function parseDuration(spec) {
  const m = String(spec).match(/^(\d+)(s|m)$/);
  if (!m) return null;
  const n = Number(m[1]);
  return m[2] === "m" ? n * 60_000 : n * 1000;
}

function signalNumber(sig) {
  return (osConstants.signals && osConstants.signals[sig]) || 0;
}

// The retry line is printed to be pasted back, so an argument with anything
// beyond plain characters is quoted: POSIX single quotes, or double quotes on
// Windows.
function shellQuote(arg) {
  const s = String(arg);
  if (/^[\w@%+=:,./-]+$/.test(s)) return s;
  return process.platform === "win32" ? `"${s.replace(/"/g, '\\"')}"` : `'${s.replace(/'/g, "'\\''")}'`;
}

// Lowers waypost's own priority first, so the command and everything it
// starts inherits it — Node maps PRIORITY_BELOW_NORMAL to nice +10 on POSIX,
// below-normal on Windows. No shell, except a .cmd/.bat target on Windows,
// which only cmd.exe can start (the argv is the caller's own command, not
// data from a registry).
async function runHeavy(argv, release) {
  try { setPriority(osConstants.priority.PRIORITY_BELOW_NORMAL); }
  catch { /* best-effort: a restricted sandbox must not block the run */ }

  // The command is arbitrary and may itself invoke `waypost` (this project's
  // own test suite does, extensively): it must see the environment it was
  // actually given, not this wrapper's own session/harness identity — pinned
  // onto process.env above by main(), for ITS OWN heartbeat/commit labelling
  // — when that identity was only invented (detected), not passed in. Left
  // leaking through, a nested `waypost` call would skip its OWN derivation
  // (main() only pins when unset) and inherit this wrapper's, which is how a
  // `waypost run --heavy -- node --test …` run once produced a session id
  // collision in an unrelated test.
  // The harness process (WAYPOST_PROC) is always derived, never passed in by a
  // caller, so a nested `waypost` must find its own the same way.
  const childEnv = { ...process.env };
  if (INHERITED_SESSION_ID === undefined) delete childEnv.WAYPOST_SESSION_ID;
  if (INHERITED_HARNESS === undefined) delete childEnv.WAYPOST_HARNESS;
  if (INHERITED_PROC === undefined) delete childEnv.WAYPOST_PROC;

  const [cmd, ...cmdArgs] = argv;
  const useShell = process.platform === "win32" && /\.(cmd|bat)$/i.test(cmd);
  let child;
  try {
    child = spawn(cmd, cmdArgs, { stdio: "inherit", shell: useShell, env: childEnv });
  } catch (e) {
    release();
    fail(`run --heavy: ${e.message}`);
  }

  const forward = (sig) => { try { child.kill(sig); } catch {} };
  process.on("SIGINT", () => forward("SIGINT"));
  process.on("SIGTERM", () => forward("SIGTERM"));

  const [code, signal] = await new Promise((res) => {
    child.on("exit", (c, s) => res([c, s]));
    child.on("error", (e) => { process.stderr.write(`waypost run --heavy: ${e.message}\n`); res([127, null]); });
  });

  release();
  process.exitCode = signal ? 128 + signalNumber(signal) : (code == null ? 1 : code);
}

// waypost run --heavy [--wait <Ns|Nm>] -- <argv…>. No wait: refuse at once,
// with the reason and the exact retry command, exit EX_TEMPFAIL. --wait
// retries every 5 seconds until the deadline, repeating the reason every 30.
async function handleRun(args) {
  if (!flag(args, "--heavy")) fail('run: only "run --heavy -- <argv…>" is supported (see `waypost help`)');
  const { tail: argv } = splitAtTerminator(args);
  if (!argv.length) fail("run --heavy: usage: waypost run --heavy [--wait <Ns|Nm>] -- <argv…>");

  let waitMs = null;
  const waitSpec = opt(args, "--wait");
  if (waitSpec != null) {
    waitMs = parseDuration(waitSpec);
    if (waitMs == null) fail(`run --heavy: --wait expects <N>s or <N>m, got "${waitSpec}"`);
  }

  let capacity, presence;
  try {
    capacity = await import(`file://${SCRIPT("capacity")}`);
    presence = await import(`file://${SCRIPT("presence")}`);
  } catch (e) { fail(`run --heavy: ${e.message}`); }

  const dir = slotsDir(presence);
  mkdirSync(dir, { recursive: true });
  const retryCmd = `waypost run --heavy -- ${argv.map(shellQuote).join(" ")}`;
  const deadline = waitMs != null ? Date.now() + waitMs : null;
  let lastPrinted = 0;

  for (;;) {
    const claim = await claimSlot(dir, argv, capacity, presence);
    if (claim.ok) {
      recordAuthority(claim.file, capacity);
      await runHeavy(argv, claim.release);
      return;
    }

    const now = Date.now();
    if (deadline == null || now >= deadline) {
      process.stderr.write(`waypost run --heavy: refused — ${claim.reason}\n  retry: ${retryCmd}\n`);
      // A holder whose boot could not be confirmed is kept rather than pruned
      // (WP-18 amendment), so the way out of a phantom has to be said out
      // loud: the only other one is waiting for the 24-hour cap.
      if (/^slots:/.test(String(claim.reason || ""))) {
        process.stderr.write("  who holds it: waypost capacity"
          + "     (a holder that is not really there: waypost capacity --release <id> --force)\n");
      }
      process.exitCode = EX_TEMPFAIL;
      return;
    }
    if (now - lastPrinted >= REASON_PRINT_MS) {
      process.stderr.write(`waypost run --heavy: waiting — ${claim.reason}\n`);
      lastPrinted = now;
    }
    await delay(Math.min(WAIT_POLL_MS, deadline - now));
  }
}

// ─── status ────────────────────────────────────────────────────────────

function handleStatus() {
  const p = configPath();
  const cfg = readConfig();
  process.stdout.write(`waypost ${VERSION}\n`);
  if (!cfg) {
    process.stdout.write(`config  (none — run \`waypost bind <vault-path>\`)\n        expected at ${p}\n`);
    return;
  }
  process.stdout.write(`config  ${p}${bindingInfo().inherited_from ? `  (inherited from the main worktree ${bindingInfo().inherited_from})` : ""}\n`);
  process.stdout.write(`vault   ${cfg.vault_path || "(unset)"}${cfg.vault_path && !existsSync(cfg.vault_path) ? "  ⚠️ missing" : ""}\n`);
  process.stdout.write(`layout  ${cfg.layout || "engineering"}\n`);
  process.stdout.write(`lang    ${cfg.language || "en"}\n`);
  const a = cfg.agents || {};
  const pins = [
    ...(a.default && a.default.model ? [`default=${a.default.model}`] : []),
    ...Object.entries(a.per_agent || {}).map(([k, v]) => v && v.model ? `${k}=${v.model}` : null),
    ...Object.entries(a.per_harness || {}).map(([k, v]) => v && v.model ? `harness:${k}=${v.model}` : null),
  ].filter(Boolean);
  if (pins.length) process.stdout.write(`models  ${pins.join(" · ")}\n`);
  process.stdout.write("\n");
  // Who else is live on this vault, before anything about roles: on a shared
  // vault that is the fact that changes what you should do next.
  run("sessions", []);
  // Roles: a count, not five paragraphs. `waypost agents list` is one command away
  // when the detail is actually wanted.
  const st = JSON.parse(run("agents", ["list", "--json"], { capture: true }) || "{}");
  const per = (st.install || []).filter((h) => h.roles.some((r) => r.state !== "absent" && r.state !== "n/a"))
    .map((h) => `${h.harness}: ${h.roles.filter((r) => r.state === "current").length}/${h.roles.length}`);
  process.stdout.write(`roles   ${(st.roles || []).length} defined · ${per.length ? per.join(" · ") : "not installed"}`
    + `  (waypost agents list)\n`);
}

// Bare `waypost` is the most likely first thing anyone types. Answer the two
// questions they actually have — is this set up, and what do I do — rather than
// printing a manual.
function handleDefault() {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) {
    process.stdout.write(`waypost ${VERSION} — not set up in ${projectRoot()}\n\n`
      + "  waypost setup         bind a vault, install the roles for this project's harnesses,\n"
      + "                    register them, and repair anything mechanical\n"
      + "  waypost setup --dry-run   see what that would do first\n"
      + "  waypost help          every command\n");
    return;
  }
  process.stdout.write(`waypost ${VERSION} · vault ${cfg.vault_path}\n\n`);
  handleNext([]);
  process.stdout.write("\nwaypost brief (orientation) · waypost help (every command)\n");
}

