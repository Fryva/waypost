#!/usr/bin/env node
// waypost — Waypost: harness-agnostic project store & verified loop.
// One entry point for Claude Code, Codex and OpenCode. The dispatcher owns
// every write to disk; the scripts under scripts/ stay pure compute printing
// JSON, which is what lets doctor re-run them to detect drift.
//
// Subcommands: see help() at the bottom, or `waypost help`.

import { resolve, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { existsSync, mkdirSync, writeFileSync, readFileSync, readdirSync, statSync, lstatSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import {
  parseFrontmatter, isInsideVault, writeFileAtomic, sessionId, storyRefOf, expandHome,
  storedVaultPath, resolveVaultPath,
} from "../scripts/lib.mjs";

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const SCRIPT = (name) => join(ROOT, "scripts", `${name}.mjs`);
const VERSION = (() => {
  try { return JSON.parse(readFileSync(join(ROOT, "package.json"), "utf8")).version; }
  catch { return "0.0.0"; }
})();

function fail(msg) {
  process.stderr.write(`waypost: ${msg}\n`);
  process.exit(1);
}

// Run a core script. `capture` pipes stdout so the dispatcher can act on the
// JSON; otherwise the child owns the terminal. Either way the child's exit
// code is ours — a harness scripting `waypost doctor && ...` must see failures.
//
// The tool root is the tree this executable belongs to, always: the children
// get WAYPOST_HOME=ROOT even when the caller exported something else. A
// dispatcher validating layouts against its own tree while its scripts read
// templates from another (O-4) is two versions of the tool in one command
// line. WAYPOST_HOME still means "tool root" for a script run directly.
function run(script, args = [], { capture = false } = {}) {
  const r = spawnSync(process.execPath, [SCRIPT(script), ...args], {
    encoding: "utf8",
    stdio: capture ? ["inherit", "pipe", "inherit"] : "inherit",
    env: { ...process.env, WAYPOST_HOME: ROOT },
  });
  if (r.error) fail(`${script}: ${r.error.message}`);
  if (r.status !== 0) process.exit(r.status ?? 1);
  return capture ? r.stdout : "";
}

function runJson(script, args = []) {
  const out = run(script, args, { capture: true });
  try {
    return JSON.parse(out);
  } catch {
    process.stdout.write(out);
    fail(`${script}: expected JSON on stdout`);
  }
}

function projectRoot() {
  return process.env.WAYPOST_PROJECT_DIR || process.env.CLAUDE_PROJECT_DIR || process.cwd();
}

function configPath() {
  const r = projectRoot();
  const waypost = join(r, ".waypost", "projectstore.json");
  if (existsSync(waypost)) return waypost;
  const legacy = join(r, ".claude", "projectstore.json");
  return existsSync(legacy) ? legacy : waypost;
}

// null means "not bound" — the right next step is `waypost bind`/`waypost setup`. A
// config that exists but does not parse is a different, louder problem: left
// indistinguishable from "not bound", `waypost setup` would silently rebind over
// it and discard whatever settings the file still held.
function readConfig() {
  const p = configPath();
  if (!existsSync(p)) return null;
  try {
    const cfg = JSON.parse(readFileSync(p, "utf8"));
    // A relative vault_path is relative to THIS machine's project root
    // (lib.mjs: storedVaultPath / resolveVaultPath).
    if (cfg && typeof cfg === "object") cfg.vault_path = resolveVaultPath(cfg.vault_path);
    return cfg;
  }
  catch (e) { fail(`config exists but is unreadable: ${p}: ${e.message}`); }
}

// Options that take a value. Everything else starting with `--` is a boolean,
// which is what separates `draft --write adr "T"` (three tokens, one flag) from
// `draft --lang ru adr "T"` (four tokens, one flag with a value). Guessing
// "the token after any flag is its value" ate the first positional whenever a
// boolean flag was written before it.
const VALUED = new Set(["--harness", "--layout", "--lang", "--only", "--id",
  "--budget", "--project", "--since", "--for", "--kind", "--limit", "--message",
  "--story", "--merge", "--session", "--provider"]);

// The literal `--` stops flag parsing, same as most POSIX CLIs: everything
// after it is positional even if it is spelled like a flag (`waypost search --
// --literal`). Only tokens before it are eligible to be a flag name or a
// flag's value.
function splitAtTerminator(args) {
  const i = args.indexOf("--");
  return i === -1 ? { head: args, tail: [] } : { head: args.slice(0, i), tail: args.slice(i + 1) };
}

function flag(args, name) {
  const { head } = splitAtTerminator(args);
  return head.includes(name) || head.some((a) => a === `${name}=true`);
}

function opt(args, name, dflt = null) {
  const { head } = splitAtTerminator(args);
  const i = head.indexOf(name);
  if (i !== -1) {
    const v = head[i + 1];
    if (v === undefined) fail(`${name} requires a value`);
    return v;
  }
  const eq = head.find((a) => a.startsWith(`${name}=`));
  return eq ? eq.slice(name.length + 1) : dflt;
}

function positionals(args) {
  const { head, tail } = splitAtTerminator(args);
  const out = [];
  for (let i = 0; i < head.length; i++) {
    const a = head[i];
    if (a.startsWith("--")) { if (VALUED.has(a)) i++; continue; }
    out.push(a);
  }
  out.push(...tail);
  return out;
}

// ─── setup: one command that leaves the project ready ──────────────────
//
// Reading a manual to configure a tool is time the tool was supposed to save.
// Everything here is derivable: where the vault goes, which harnesses this
// project uses, which repairs are mechanical. So derive it, do it, and print
// what happened — with --dry-run for anyone who wants to look first.
function handleSetup(args) {
  const dry = flag(args, "--dry-run");
  const say = (l) => process.stdout.write(l + "\n");
  const step = (label, fn) => { if (dry) { say(`would ${label}`); return null; } say(label); return fn(); };

  const existing = readConfig();
  const vault = opt(args, "--vault") || (existing && existing.vault_path) || guessVault();
  say(`project ${projectRoot()}`);

  if (!existing || !existing.vault_path) {
    step(`bind vault ${vault}`, () => handleBind([vault, ...passThrough(args, ["--layout", "--lang"])]));
  } else {
    say(`vault  ${existing.vault_path} (already bound)`);
    step("scaffold any missing layout folders", () => handleScaffold([]));
  }

  const harnesses = opt(args, "--harness");
  const detected = detectedHarnesses();
  if (harnesses || detected.length) {
    step(`install roles for ${harnesses || detected.join(", ")}`,
      () => run("agents", ["install", ...(harnesses ? ["--harness", harnesses] : [])]));
    step("register the routing block", () => run("agents", ["register"]));
  } else {
    say("no harness detected — run `waypost agents install --harness <id>` once you pick one");
    say("  (`waypost harnesses --all` lists what is supported)");
  }

  // Not run(): doctor is a diagnostic, and `--fix` only mends what is
  // mechanical — a harness/spec/layout finding it cannot touch must not turn
  // `waypost setup` into a hard failure for having done the mechanical part of
  // its job. spawnSync here so setup can read and print the report itself
  // and add the one line that matters: whether anything still needs a human.
  step("repair the mechanical install findings", () => {
    const r = spawnSync(process.execPath, [SCRIPT("doctor"), "--install", "--fix"], {
      encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
    });
    process.stdout.write(r.stdout || "");
    if (r.stderr) process.stderr.write(r.stderr);
    const m = (r.stdout || "").match(/Summary: (\d+) issue/);
    if (m && Number(m[1]) > 0) process.stdout.write(`${m[1]} finding(s) remain — waypost doctor\n`);
  });
  if (!dry) {
    process.stdout.write("\nready. Next:\n");
    process.stdout.write("  waypost next                      what this project needs right now\n");
    process.stdout.write("  waypost brief                     orientation at the start of a session\n");
    process.stdout.write('  waypost draft adr "<decision>" --write\n');
  }
}

// A vault the project already has, or a conventional place for a new one. Never
// a path outside the project: the vault travels with the repository unless the
// user says otherwise.
function guessVault() {
  const root = projectRoot();
  for (const c of ["vault", "docs/vault", "knowledge", ".vault"]) {
    if (existsSync(join(root, c, "adr")) || existsSync(join(root, c, "epics"))) return join(root, c);
  }
  return join(root, existsSync(join(root, "docs")) ? "docs/vault" : "vault");
}

function detectedHarnesses() {
  try {
    return JSON.parse(run("agents", ["harnesses", "--json"], { capture: true }))
      .harnesses.filter((h) => (h.detect || []).some((d) => existsSync(join(projectRoot(), d))))
      .map((h) => h.id);
  } catch { return []; }
}

function passThrough(args, names) {
  const out = [];
  for (const n of names) { const v = opt(args, n); if (v) out.push(n, v); }
  return out;
}

// A finding's message, trimmed to its lead clause for a one-line summary:
// split on " — " first (several finding generators use it deliberately as a
// clause separator), else on the first SENTENCE-ending period (one followed
// by whitespace or end of string) — never the first bare ".", which cuts a
// message off mid-path on anything naming a file (kanban.md, .gitattributes,
// .waypost/…) or a domain-shaped word.
function leadClause(message) {
  const dash = message.split(" — ")[0];
  return dash !== message ? dash : message.split(/\.(?:\s|$)/)[0];
}

// ─── next: what this project needs right now ───────────────────────────
//
// The judgement an agent otherwise has to make from scratch every session, made
// deterministically instead: read the state, rank what is actionable, print the
// command. Cheap by construction — no artifact content, one line per item.
function handleNext(args) {
  const cfg = readConfig();
  const items = [];
  if (!cfg || !cfg.vault_path) {
    process.stdout.write("not bound to a vault yet — run `waypost setup`\n");
    return;
  }
  const findings = (() => {
    try { return JSON.parse(run("doctor", ["--json"], { capture: true })); } catch { return []; }
  })();
  const by = (check, level) => findings.filter((f) => f.check === check && (!level || f.level === level));

  for (const f of findings.filter((f) => f.level === "issue")) {
    items.push([1, leadClause(f.message).slice(0, 110), repairFor(f)]);
  }
  const state = (() => {
    try { return JSON.parse(run("sessions", ["--json"], { capture: true })); } catch { return {}; }
  })();
  for (const c of (state.claims || []).filter((c) => c.session !== state.session_id)) {
    items.push([2, `${c.story} is being worked on by ${c.session} (${c.harness || "?"}, ${c.host})`,
      "coordinate before touching it"]);
  }
  for (const f of by("work-without-story", "warn")) {
    items.push([3, "source changes with no story open", 'waypost draft story <EPIC> "<title>" --write']);
  }
  for (const f of findings.filter((f) => f.level === "warn" && f.check !== "work-without-story")) {
    items.push([4, leadClause(f.message).slice(0, 110), repairFor(f)]);
  }
  for (const f of by("agent-roles", "info").concat(by("agents-block", "info"))) {
    items.push([5, leadClause(f.message).slice(0, 110), repairFor(f)]);
  }

  if (!items.length) {
    process.stdout.write("nothing needs doing: vault consistent, roles installed, no conflicting session.\n"
      + "Next feature-sized change starts with `waypost draft story <EPIC> \"<title>\" --write`.\n");
    return;
  }
  items.sort((a, b) => a[0] - b[0]);
  for (const [, what, how] of items.slice(0, 8)) {
    process.stdout.write(`- ${what}\n${how ? `    ${how}\n` : ""}`);
  }
  if (items.length > 8) process.stdout.write(`…and ${items.length - 8} more (waypost doctor)\n`);
}

function repairFor(f) {
  if (f.check === "code-refs") return "fix the path, or mark it (waiting)/(planned)/(deleted)";
  if (f.check === "supersedes") return "correct supersedes/superseded_by on both artifacts";
  if (f.check === "acceptance-gate") return "record the review outcome in review_status";
  const map = {
    kanban: "waypost reconcile --write", "code-map": "waypost reconcile --write", indexes: "waypost reconcile --write",
    graph: "waypost graph", "agent-roles": "waypost agents install", "agents-block": "waypost agents register",
    gitignore: "waypost doctor --fix", "vault-git": "waypost doctor --fix", "merge-driver": "waypost doctor --fix",
    "line-endings": "waypost doctor --fix", config: "waypost setup",
  };
  return map[f.check] || null;
}

// ─── bind ──────────────────────────────────────────────────────────────

// A-2: shared by handleBind (a --layout flag) and handleScaffold (a layout
// already sitting in .waypost/projectstore.json) — a bad value in either place
// must get this same actionable message, not a raw ENOENT from whichever
// readFileSync happens to hit it first.
function checkLayoutExists(layout) {
  if (!existsSync(join(ROOT, "scaffold", "layouts", `${layout}.json`))) {
    fail(`unknown layout "${layout}" — available: ${readdirSync(join(ROOT, "scaffold", "layouts")).map((n) => n.replace(/\.json$/, "")).join(", ")}`);
  }
}

function handleBind(args) {
  const [vault] = positionals(args);
  if (!vault) fail('bind <vault-path> [--layout engineering] [--lang en|ru|es|de|fr|zh]');
  const abs = resolve(expandHome(vault));
  const layout = opt(args, "--layout", "engineering");
  const lang = opt(args, "--lang", "en");
  checkLayoutExists(layout);
  if (!existsSync(join(ROOT, "templates", lang))) {
    fail(`unknown language "${lang}" — available: ${readdirSync(join(ROOT, "templates")).filter((n) => !n.includes(".")).join(", ")}`);
  }
  const existing = readConfig();
  if (existing && existing.vault_path && resolve(existing.vault_path) !== abs && !flag(args, "--force")) {
    fail(`already bound to ${existing.vault_path} — re-run with --force to rebind to ${abs}`);
  }
  mkdirSync(abs, { recursive: true });
  const cfgPath = join(projectRoot(), ".waypost", "projectstore.json");
  mkdirSync(dirname(cfgPath), { recursive: true });
  const stored = storedVaultPath(abs);
  const cfg = {
    ...(existing || {}),
    vault_path: stored,
    layout,
    language: lang,
    default_author: (existing && existing.default_author) || gitUser(),
    waypost: { version: VERSION },
  };
  writeFileSync(cfgPath, JSON.stringify(cfg, null, 2) + "\n", "utf8");
  process.stdout.write(`bound  ${abs}${stored !== abs ? `  (stored as ${stored}, relative to the project)` : ""}\nconfig ${cfgPath}\n`);
  process.env.WAYPOST_PROJECT_DIR = projectRoot();
  handleScaffold([]);
  process.stdout.write(
    "\nnext:\n" +
    "  waypost agents install         install the roles into the harnesses this project uses\n" +
    '  waypost draft adr "<title>" --write\n' +
    "  waypost doctor\n",
  );
}

function gitUser() {
  const r = spawnSync("git", ["config", "--get", "user.name"], { encoding: "utf8" });
  return (r.stdout || "").trim() || process.env.USER || "unknown";
}

// ─── scaffold ──────────────────────────────────────────────────────────

// The deterministic half of upstream's /bind: layout folders and their index
// READMEs. Prose lives in prompts/bind.md; the directories are mechanical, so
// they are the CLI's job and never an LLM's.
function handleScaffold(args) {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) fail("no bound vault — run `waypost bind <vault-path>` first");
  checkLayoutExists(cfg.layout || "engineering");
  const layout = JSON.parse(readFileSync(join(ROOT, "scaffold", "layouts", `${cfg.layout || "engineering"}.json`), "utf8"));
  const lang = cfg.language || "en";
  const created = [];
  for (const folder of layout.folders) {
    const dir = join(cfg.vault_path, folder.path);
    if (!existsSync(dir)) { mkdirSync(dir, { recursive: true }); created.push(folder.path + "/"); }
    if (!folder.readme) continue;
    const p = join(dir, "README.md");
    if (existsSync(p)) continue;
    const tmpl = readFileSync(join(ROOT, "templates", lang, "folder-readme.md.tmpl"), "utf8");
    const title = folder.path.charAt(0).toUpperCase() + folder.path.slice(1);
    // doctor reads the first prose paragraph as the folder's purpose, so the
    // default has to say what the folder holds, not merely name it.
    writeFileSync(p, tmpl
      .replace(/\{\{folder_name\}\}/g, title)
      .replace(/\{\{folder_description\}\}/g,
        `\`${folder.kind}\` artifacts of the \`${layout.name}\` layout, maintained by waypost.`), "utf8");
    created.push(`${folder.path}/README.md`);
  }
  if (flag(args, "--json")) { process.stdout.write(JSON.stringify({ created }, null, 2) + "\n"); return; }
  if (!created.length) process.stdout.write("scaffold: vault already complete\n");
  else process.stdout.write(`scaffold: created ${created.length} item(s)\n  ${created.join("\n  ")}\n`);
}

// ─── draft ─────────────────────────────────────────────────────────────

function handleDraft(args) {
  const pos = positionals(args);
  const [kind, ...rest] = pos;
  if (!kind || !rest.length) {
    fail('draft <adr|spec|epic|story|research|concept|meeting|runbook> "<title>" [--write] [--lang <code>]\n' +
         '       draft epic <EPIC-ID> "<title>"   |   draft story <EPIC-ID> "<title>"');
  }
  const lang = opt(args, "--lang");
  const out = runJson("draft", [kind, ...rest, ...(lang ? ["--lang", lang] : [])]);
  if (!flag(args, "--write")) {
    if (flag(args, "--json")) { process.stdout.write(JSON.stringify(out, null, 2) + "\n"); return; }
    // A preview used to print the whole rendered artifact — several hundred
    // tokens of template the reader is about to see on disk anyway. What a
    // decision needs is: where it lands, what the index row says, what is wrong.
    process.stdout.write(`would create ${out.path}\n`);
    if (out.index && out.index.line) process.stdout.write(`index row     ${out.index.line}\n`);
    if (out.collision) process.stdout.write(`⚠️  collision  "${out.collision.identity || ""}" already exists as ${out.collision.with}\n`);
    for (const w of out.warnings || []) process.stdout.write(`⚠️  ${w}\n`);
    const head = String(out.content).split("\n").slice(0, 8).join("\n");
    process.stdout.write(`\n${head}\n…\n\n--write to create it · --json for the full payload\n`);
    return;
  }
  if (out.collision) {
    fail(`topic collision: "${out.collision.identity || kind}" already exists as ${out.collision.with}. ` +
         "Extend that artifact, or pick a different title.");
  }
  if (existsSync(out.path)) fail(`refusing to overwrite ${out.path}`);
  mkdirSync(dirname(out.path), { recursive: true });
  // sweep:false — this directory is not reconcile's own regeneration loop,
  // so there is no reason to pay for scanning it for orphaned temps here.
  writeFileAtomic(out.path, out.content, { sweep: false });
  process.stdout.write(`created ${out.path}\n`);
  for (const w of out.warnings || []) process.stdout.write(`⚠️  ${w}\n`);
  // The index row and the board are derived views: regenerate rather than
  // patch, so a hand-edit can never leave them permanently out of step. The
  // artifact is already on disk at this point, so a reconcile failure must be
  // reported against it rather than exiting as if the write had not happened.
  reconcileAfterWrite();
}

function reconcileAfterWrite() {
  const r = spawnSync(process.execPath, [SCRIPT("reconcile"), "--write"], {
    encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
  });
  let failed = [];
  let did = null;
  try {
    const out = JSON.parse(r.stdout || "{}");
    failed = [out.kanban, out.codemap, out.graph, ...(out.indexes || [])]
      .filter((t) => t && t.error).map((t) => `${t.path || t.target || "?"}: ${t.error}`);
    // Name only the views that were actually (re)written: the message used to
    // claim "code-map, graph" even on a fresh vault where both are skipped by
    // design, one line above doctor's own "No graph.md yet" (E-2).
    const wrote = [];
    if ((out.indexes || []).some((t) => t && t.written)) wrote.push("indexes");
    for (const k of ["kanban", "codemap", "graph"]) if (out[k] && out[k].written) wrote.push(k === "codemap" ? "code-map" : k);
    did = wrote;
  } catch { /* fall through to the exit code */ }
  if (r.status === 0 && !failed.length) {
    process.stdout.write(did && did.length
      ? `derived views reconciled (${did.join(", ")})\n`
      : did ? "derived views already up to date\n"
      : "derived views reconciled\n");
    return;
  }
  process.stderr.write("waypost: the artifact was written, but reconciling the derived views failed:\n"
    + (failed.length ? failed.map((f) => `  ${f}\n`).join("") : `  ${(r.stderr || "").trim()}\n`)
    + "  fix the cause, then run `waypost reconcile --write`.\n");
  process.exitCode = 1;
}

// ─── story gates ───────────────────────────────────────────────────────

function handleStory(args) {
  const [mode, storyPath] = positionals(args);
  if (!["plan", "close"].includes(mode) || !storyPath) {
    fail("story <plan|close> <story-path> [--write]");
  }
  const out = runJson("story-section", [mode, storyPath]);
  if (!flag(args, "--write")) {
    process.stdout.write(JSON.stringify({ ...out, content: undefined }, null, 2) + "\n");
    process.stdout.write("(preview only — re-run with --write to apply)\n");
    return;
  }
  // story-section.mjs will transform any file with a frontmatter block, not
  // only a real vault story — refuse to write anywhere outside the bound
  // vault rather than trust a positional path the caller supplied.
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path || !isInsideVault(resolve(out.path), cfg.vault_path)) {
    fail(`refusing to write outside the vault: ${out.path}`);
  }
  if (!out.changed) { process.stdout.write(`unchanged ${out.path}\n`); return; }
  // Re-check against the file story-section actually read: between that read
  // and this write another session (or a hand edit) may have changed it, and
  // `content` was computed from the OLD bytes — writing it now would silently
  // discard the concurrent edit.
  let current;
  try { current = readFileSync(out.path, "utf8"); } catch (e) { fail(`${out.path}: ${e.message}`); }
  if (createHash("sha256").update(current, "utf8").digest("hex") !== out.original_sha256) {
    fail(`${out.path} changed since it was read — re-run`);
  }
  // sweep:false — same reasoning as handleDraft's write.
  writeFileAtomic(out.path, out.content, { sweep: false });
  process.stdout.write(`${mode}  ${out.path}\n  ${(out.notes || []).join("\n  ")}\n`);
  // Opening a story claims it for this session; closing it releases the claim.
  // Other harnesses on the same vault read that registry, so the gate is also
  // the announcement — nobody has to remember a separate command.
  claimForStory(mode === "plan" ? out.path : null, cfg.vault_path);
  reconcileAfterWrite();
}

function claimForStory(storyPath, vault) {
  // Warn, do not refuse: re-planning a story someone else opened changes the
  // file idempotently, and the moment that actually needs a gate is the commit.
  // But the session that is about to duplicate work should hear about it here.
  if (storyPath) {
    const r = spawnSync(process.execPath, [SCRIPT("sessions"), "--json"], {
      encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
    });
    try {
      const { claims = [], session_id: self } = JSON.parse(r.stdout || "{}");
      const ref = storyRefOf(storyPath, vault);
      const others = ref ? claims.filter((c) => c.story === ref && c.session !== self) : [];
      if (others.length) {
        process.stderr.write(`⚠️  ${ref} is already claimed by ${others.map((o) => `${o.session} (${o.harness || "?"})`).join(", ")}`
          + " — two sessions on one story is how the same work gets done twice.\n");
      }
    } catch { /* the registry is advisory; never block the gate on it */ }
  }
  const args = storyPath ? ["--claim", storyPath] : ["--release"];
  const r = spawnSync(process.execPath, [SCRIPT("sessions"), ...args], {
    encoding: "utf8", env: { ...process.env, WAYPOST_HOME: ROOT },
  });
  const line = (r.stdout || "").split("\n").find((l) => l.startsWith("claimed") || l.startsWith("released"));
  if (line) process.stdout.write(`  ${line.trim()}  (visible to other sessions via \`waypost sessions\`)\n`);
}

// ─── derived views ─────────────────────────────────────────────────────

const DERIVED = { kanban: "kanban", graph: "graph", codemap: "codemap" };

// A graph or an index grows with the vault: at 200 artifacts graph.md is ~13k
// tokens and an index ~10k. Reading either whole to answer one question is the
// single largest avoidable cost on a big project, so the CLI answers the
// question instead — the derived views stay the source, this is just a lens.
function handleGraphQuery(target, args) {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) fail("no bound vault — run `waypost bind <vault-path>` first");
  const p = join(cfg.vault_path, "graph.md");
  if (!existsSync(p)) fail("no graph.md yet — run `waypost graph`");
  const needle = target.replace(/\\/g, "/").replace(/^\.\//, "");
  const lines = readFileSync(p, "utf8").split("\n");
  const hits = lines.filter((l) => l.includes(needle) && l.startsWith("|"));
  if (!hits.length) {
    fail(`no node or edge mentions "${needle}" in graph.md.\n`
      + "       Nodes are keyed by vault-relative path (adr/foo.md), not by slug.");
  }
  const node = hits.filter((l) => !/\|\s*(supersedes|superseded_by|covers|covered_by|contains|part_of|links|link)\s*\|/i.test(l));
  const edges = hits.filter((l) => !node.includes(l));
  process.stdout.write(`${needle}\n`);
  for (const l of node) process.stdout.write(`  ${l.replace(/^\|\s*/, "").replace(/\s*\|\s*$/, "").replace(/\s*\|\s*/g, " · ")}\n`);
  if (edges.length) {
    process.stdout.write(`\nedges (${edges.length}):\n`);
    for (const l of edges.slice(0, 60)) {
      process.stdout.write(`  ${l.replace(/^\|\s*/, "").replace(/\s*\|\s*$/, "").replace(/\s*\|\s*/g, " → ")}\n`);
    }
    if (edges.length > 60) process.stdout.write(`  …and ${edges.length - 60} more\n`);
  }
}

// Vault-wide search that returns pointers, not documents: path, title, status
// and the matching line. The alternative an agent falls back to is grep plus a
// handful of full-file reads.
function handleSearch(args) {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) fail("no bound vault — run `waypost bind <vault-path>` first");
  const terms = positionals(args);
  if (!terms.length) fail('search "<text>" [--kind adr|spec|epic|story|…] [--limit 20]');
  const kind = opt(args, "--kind");
  const limitRaw = opt(args, "--limit", "20");
  const limit = Number(limitRaw);
  if (!Number.isInteger(limit) || limit <= 0) fail(`--limit must be a positive integer, got "${limitRaw}"`);
  const re = new RegExp(terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|"), "i");
  const out = [];
  // iCloud leaves a placeholder — ".<name>.icloud" — for a file evicted from
  // local storage; the real name never appears in the listing until it syncs
  // back down. Counted, not searched: its content is not on disk to match.
  const notDownloaded = [];
  const walk = (dir, rel) => {
    let names = [];
    try { names = readdirSync(dir); } catch { return; }
    for (const n of names) {
      if (n.startsWith(".")) {
        const icloud = /^\.(.+)\.icloud$/.exec(n);
        if (icloud) notDownloaded.push(rel ? `${rel}/${icloud[1]}` : icloud[1]);
        continue;
      }
      const abs = join(dir, n);
      const r = rel ? `${rel}/${n}` : n;
      let lst; try { lst = lstatSync(abs); } catch { continue; }
      // A symlinked directory is never descended into: cheap protection
      // against a cycle (a directory symlinked into itself or an ancestor),
      // at the cost of not walking a legitimate symlinked subtree. A
      // symlinked FILE falls through to the same read path as a real one.
      if (lst.isSymbolicLink()) {
        let target; try { target = statSync(abs); } catch { continue; }
        if (target.isDirectory()) continue;
      } else if (lst.isDirectory()) {
        walk(abs, r);
        continue;
      } else if (!lst.isFile()) {
        continue;
      }
      if (!n.endsWith(".md")) continue;
      if (["kanban.md", "graph.md", "code-map.md"].includes(n)) continue;
      let text; try { text = readFileSync(abs, "utf8"); } catch { continue; }
      // parseFrontmatter, not an inline \n-only regex: a CRLF or BOM file
      // (the exact shape doctor's own cross-OS checks exist to catch before
      // it is fixed) used to read as "no frontmatter at all" here, so
      // `--kind` silently dropped every match and title/status came back
      // from the filename instead of the artifact's own fields.
      const fm = parseFrontmatter(text).data;
      if (kind && String(fm.type ?? "") !== kind) continue;
      const lines = text.split("\n");
      const hitLine = lines.findIndex((l) => re.test(l));
      if (hitLine === -1 && !re.test(r)) continue;
      out.push({ path: r, title: String(fm.title ?? "") || n, status: fm.status == null ? "" : String(fm.status),
        line: hitLine === -1 ? null : `${hitLine + 1}: ${lines[hitLine].trim().slice(0, 120)}` });
    }
  };
  walk(cfg.vault_path, "");
  if (!out.length) { process.stdout.write("no match\n"); }
  else {
    for (const h of out.slice(0, limit)) {
      process.stdout.write(`${h.path}${h.status ? `  (${h.status})` : ""}\n  ${h.title}\n`
        + (h.line ? `  ${h.line}\n` : ""));
    }
    if (out.length > limit) process.stdout.write(`…and ${out.length - limit} more (--limit)\n`);
  }
  if (notDownloaded.length) {
    process.stdout.write(`${notDownloaded.length} file(s) not downloaded from iCloud — open them once to sync\n`);
  }
}

function handleDerived(cmd, args) {
  if (flag(args, "--json")) { process.stdout.write(run(cmd, [], { capture: true })); return; }
  const out = runJson("reconcile", ["--write", "--only", DERIVED[cmd]]);
  const target = out[cmd] || {};
  if (target.error) fail(`${cmd}: ${target.error}`);
  if (target.skipped) { process.stdout.write(`${cmd}: ${target.skipped}\n`); return; }
  process.stdout.write(`${target.written ? "written" : "unchanged"} ${target.path || cmd}\n`);
}

// `waypost reconcile` is listed beside kanban/graph/codemap, so it answers in
// the same voice — a line per view — instead of the raw JSON its programmatic
// callers (draft, commit, the merge driver) consume. `--json` still yields that
// shape for anyone composing it.
function handleReconcile(args) {
  if (flag(args, "--json")) { process.stdout.write(run("reconcile", args.filter((a) => a !== "--json"), { capture: true })); return; }
  const wrote = flag(args, "--write");
  const out = runJson("reconcile", args);
  const line = (label, t) => {
    if (!t) return;
    if (t.error) { process.stdout.write(`  ${label}: error — ${t.error}\n`); return; }
    if (t.skipped) { process.stdout.write(`  ${label}: ${t.skipped}\n`); return; }
    process.stdout.write(`  ${label}: ${t.written ? "written" : "unchanged"}${t.path ? ` ${t.path}` : ""}\n`);
  };
  process.stdout.write(`${wrote ? "reconciled" : "dry run (nothing written; add --write)"}\n`);
  line("kanban", out.kanban);
  line("code-map", out.codemap);
  line("graph", out.graph);
  for (const idx of out.indexes || []) line(idx.path || "index", idx);
  if (out.summary && out.summary.failed > 0) process.exitCode = 1;
}

// ─── prompts & skills ──────────────────────────────────────────────────

function printDoc(dir, name, suffix) {
  const base = join(ROOT, dir);
  const names = readdirSync(base)
    .map((n) => n.replace(/\.md$/, ""))
    .filter((n) => !n.startsWith("."))
    .sort();
  if (!name) {
    process.stdout.write(`${dir}:\n  ${names.join("\n  ")}\n\nPrint one with: waypost ${dir === "prompts" ? "prompt" : "skill"} <name>\n`);
    return;
  }
  // A name, never a path: `waypost prompt ../README` used to print whatever the
  // traversal landed on.
  if (!/^[\w.-]+$/.test(name) || name.includes("..")) fail(`not a valid name: ${name}`);
  const p = suffix ? join(base, name, suffix) : join(base, `${name}.md`);
  if (!existsSync(p)) fail(`no such ${dir === "prompts" ? "prompt" : "skill"}: ${name} (have: ${names.join(", ")})`);
  process.stdout.write(readFileSync(p, "utf8"));
}

// ─── status ────────────────────────────────────────────────────────────

function handleStatus() {
  const p = configPath();
  const cfg = readConfig();
  process.stdout.write(`waypost ${VERSION}\n`);
  if (!cfg) {
    process.stdout.write(`config  (none — run \`waypost bind <vault-path>\`)\n        expected at ${p}\n`);
    return;
  }
  process.stdout.write(`config  ${p}\n`);
  process.stdout.write(`vault   ${cfg.vault_path || "(unset)"}${cfg.vault_path && !existsSync(cfg.vault_path) ? "  ⚠️ missing" : ""}\n`);
  process.stdout.write(`layout  ${cfg.layout || "engineering"}\n`);
  process.stdout.write(`lang    ${cfg.language || "en"}\n`);
  const a = cfg.agents || {};
  const pins = [
    ...(a.default && a.default.model ? [`default=${a.default.model}`] : []),
    ...Object.entries(a.per_agent || {}).map(([k, v]) => v && v.model ? `${k}=${v.model}` : null),
    ...Object.entries(a.per_harness || {}).map(([k, v]) => v && v.model ? `harness:${k}=${v.model}` : null),
  ].filter(Boolean);
  if (pins.length) process.stdout.write(`models  ${pins.join(" · ")}\n`);
  process.stdout.write("\n");
  // Who else is live on this vault, before anything about roles: on a shared
  // vault that is the fact that changes what you should do next.
  run("sessions", []);
  // Roles: a count, not five paragraphs. `waypost agents list` is one command away
  // when the detail is actually wanted.
  const st = JSON.parse(run("agents", ["list", "--json"], { capture: true }) || "{}");
  const per = (st.install || []).filter((h) => h.roles.some((r) => r.state !== "absent" && r.state !== "n/a"))
    .map((h) => `${h.harness}: ${h.roles.filter((r) => r.state === "current").length}/${h.roles.length}`);
  process.stdout.write(`roles   ${(st.roles || []).length} defined · ${per.length ? per.join(" · ") : "not installed"}`
    + `  (waypost agents list)\n`);
}

// Bare `waypost` is the most likely first thing anyone types. Answer the two
// questions they actually have — is this set up, and what do I do — rather than
// printing a manual.
function handleDefault() {
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path) {
    process.stdout.write(`waypost ${VERSION} — not set up in ${projectRoot()}\n\n`
      + "  waypost setup         bind a vault, install the roles for this project's harnesses,\n"
      + "                    register them, and repair anything mechanical\n"
      + "  waypost setup --dry-run   see what that would do first\n"
      + "  waypost help          every command\n");
    return;
  }
  process.stdout.write(`waypost ${VERSION} · vault ${cfg.vault_path}\n\n`);
  handleNext([]);
  process.stdout.write("\nwaypost brief (orientation) · waypost help (every command)\n");
}

function help() {
  process.stdout.write(`waypost — Waypost ${VERSION}

USAGE
  waypost <command> [args]
  waypost <command> [args] -- <literal positional, even if it looks like a flag>

START HERE
  setup                    do the whole install: bind a vault, scaffold it,
                           install the roles for the harnesses this project
                           uses, register them, repair the mechanical findings
                           [--vault <path>] [--harness <id>] [--dry-run]
  next                     what this project needs right now, ranked, with the
                           command for each

VAULT
  bind <vault-path>        bind a vault and scaffold the layout (alias: init)
                           [--layout <name>] [--lang <en|ru|es|de|fr|zh>] [--force]
  scaffold                 (re)create the layout's folders and index READMEs
  status                   bound-vault summary + agent-role install state
  draft <kind> "<title>"   render an artifact; --write creates it and reconciles
                           (epic/story take a leading id: draft epic <ID> "…",
                            draft story <EPIC> "…")
                           kinds: adr spec epic story research concept meeting runbook
  story <plan|close> <p>   story lifecycle gate; --write applies
  kanban | graph | codemap regenerate one derived view (--json to preview only)
  graph --for <path>       one artifact's typed neighbourhood, instead of
                           reading a graph that grows with the vault
  search "<text>"          vault-wide search returning pointers, not documents
                           [--kind adr|spec|story|…] [--limit N]
  reconcile [--write]      re-derive every view (indexes, kanban, code-map, graph)
  brief                    session-start orientation packet (run it when you
                           start work: where things live, what is in flight)
  doctor [flags]           deterministic diagnostics (--install|--vault|--fix)
  diff-refs [flags]        changed-file evidence for code_refs

WORKING IN SEVERAL HARNESSES AT ONCE
  commit -m "<what>"       commit with the trailers that say which harness,
                           session and story it came from [--story <id>]
                           [--all: everything not ignored | --tracked]
                           [--dry-run] [-- <paths>]
  merge <ref>              merge, re-derive the views, then commit — so the
                           board in the merge commit matches the merged vault
  log [--story|--harness|--provider|--session <v>]
                           the history, read back through those trailers
  sessions --claim <story> tell the other live sessions what you are on
  lease <path…>            announce the files you are editing right now, so a
                           session on another device does not touch them
                           (lease list | lease release [path…])
  watch                    stay live: beat on an interval and report who joins,
                           leaves or picks up a story on another device
  storage                  what the vault is stored on and how far behind
                           another device's presence can be
  merge-derived <file>     git merge driver: regenerate a derived view instead
                           of merging two machine-written copies of it

ROLES (same roles in every harness)
  agents list              roles + per-harness install state
  agents show <role>       print the role prompt (fresh-context handoff)
  harnesses                every harness waypost can render roles for, and where
                           they land (* = detected here)
  agents install           render the roles into the harnesses this project
                           uses  [--harness <id>[,<id>…]|all]
  agents uninstall         remove generated role files
  agents register          write the routing block into AGENTS.md / CLAUDE.md
  agents unregister        remove that routing block again  [--dry-run]
  agents model <role|default|harness:<name>> <id>
                           pin a model; role/default reach only harnesses with
                           a published tier naming, harness:<name> the rest

PROCEDURES
  prompt [name]            print a workflow procedure (the verified loop's steps)
  skill [name]             print a skill (proactive procedure)
  sessions [--touch]       active-session registry (--claim/--release/--prune)
  tokens [flags]           what the loop cost, from Claude Code transcripts
                           (Claude-only: no other harness writes them)

HARNESS-AGNOSTIC
  No hooks, no status line, no slash commands: the CLI is the interface, and
  the roles are rendered into whatever each harness understands. A harness is a
  JSON file in harnesses/ — add your own in .waypost/harnesses/ (waypost harnesses).
  Project root: WAYPOST_PROJECT_DIR (else cwd). Tool root: the tree this
  executable belongs to (WAYPOST_HOME applies to a script run directly).
`);
}

// ─── lease ─────────────────────────────────────────────────────────────
//
// AGENTS.md and this file's own help() document `waypost lease <path…>` — a path
// as the first token, not a subcommand. presence.mjs's own CLI takes
// `lease|acquire|release|list|watch|storage` as its first token, so a path
// forwarded unchanged reads as an unknown subcommand. Insert the implied
// "lease" subcommand unless the caller already named a real one, or gave only
// flags (`waypost lease --json`, read as "list mine, as json" — there is no path
// to lease, so there is nothing to insert "lease" in front of).
const LEASE_SUBCOMMANDS = new Set(["lease", "acquire", "release", "list", "watch", "storage"]);
function leaseArgs(rest) {
  if (!rest.length) return ["list"];
  if (LEASE_SUBCOMMANDS.has(rest[0])) return rest;
  if (rest[0].startsWith("--")) return ["list", ...rest];
  return ["lease", ...rest];
}

// Presence is only useful if it happens without being asked. Every command that
// implies work beats the session's heartbeat, so another device sees this
// session without anyone remembering `waypost sessions --touch`. Never fails the
// command, never runs for a read-only lookup, and WAYPOST_NO_BEAT=1 turns it off.
const QUIET_COMMANDS = new Set(["help", "--help", "-h", "version", "--version", "-v",
  "harnesses", "prompt", "skill", "agents", "log", "storage", "merge-derived"]);

// ─── brief: the session start also installs its own harness ───────────
//
// `waypost setup` installs roles for the harnesses the PROJECT shows evidence
// of (a .codex/ directory, a CLAUDE.md with the user's own content). A harness
// that simply opens the project for the first time has left no such evidence
// yet — but the session running this command knows what it is (the registry's
// env markers, or WAYPOST_HARNESS, pinned by heartbeat()). So the session-start
// command renders the roles of the harness it runs in when they are absent or
// stale, makes sure that harness's own instruction file carries the routing
// block, and says what it wrote — those files are committed by convention, and
// git carries them to every other machine and harness. Nothing is written when
// nothing is missing; `--no-install` (or WAYPOST_NO_INSTALL=1) reads only.
async function selfInstall(rest) {
  if (rest.includes("--no-install") || process.env.WAYPOST_NO_INSTALL) return;
  const cfg = readConfig();
  if (!cfg || !cfg.vault_path || !existsSync(cfg.vault_path)) return;
  try {
    const A = await import(`file://${SCRIPT("agents")}`);
    const h = process.env.WAYPOST_HARNESS || A.detectHarness();
    if (!h || h === "unknown" || !A.harnessIds().includes(h)) return;
    const proj = projectRoot();
    const did = [];
    const st = A.status({ proj, cfg }).find((x) => x.harness === h);
    if (st && st.roles.some((r) => r.state === "absent" || r.state === "stale")) {
      const wrote = A.install([h], { proj, cfg }).filter((r) => r.action === "created" || r.action === "updated");
      if (wrote.length) did.push(`installed ${wrote.length} role file(s) into ${(A.harness(h).roles || {}).dir || "its agents directory"}/`);
    }
    const targets = A.instructionTargetFor(h, proj);
    const reg = targets.length ? A.register({ proj, cfg, files: targets }).filter((r) => r.action !== "unchanged") : [];
    if (reg.length) did.push(`${reg[0].action} the routing block in ${reg.map((r) => r.file).join(", ")}`);
    if (!did.length) return;
    const note = `This session runs in ${h}, which this project was not set up for yet — ${did.join("; ")}. `
      + "Commit them, so every machine and harness gets the same roles (`waypost brief --no-install` reads only).\n\n";
    (rest.includes("--json") ? process.stderr : process.stdout).write(note);
  } catch { /* orientation must never fail because the install could not be repaired */ }
}

async function heartbeat(cmd) {
  if (QUIET_COMMANDS.has(cmd) || process.env.WAYPOST_NO_BEAT) return;
  try {
    // Session id is already resolved and pinned in WAYPOST_SESSION_ID by main()
    // before this runs (G-1) — no need to import sessions.mjs or lib.mjs just
    // to derive it again here.
    // Resolve the harness once, here, and pin it in the environment so the
    // child this command spawns (sessions, lease, watch, status, brief) labels
    // the session the way commits already do — presence used to show "?" for a
    // session commit stamped "claude" (E-3). Detection reads the registry, so
    // do it only when a beat is actually going to happen.
    if (!process.env.WAYPOST_HARNESS) {
      try {
        const { detectHarness } = await import(`file://${SCRIPT("agents")}`);
        const h = detectHarness();
        if (h && h !== "unknown") process.env.WAYPOST_HARNESS = h;
      } catch { /* detection is best-effort; a null harness is still valid */ }
    }
    const { beat } = await import(`file://${SCRIPT("presence")}`);
    const cfg = readConfig();
    if (cfg && cfg.vault_path && existsSync(cfg.vault_path)) {
      beat(cfg.vault_path, process.env.WAYPOST_SESSION_ID, { harness: process.env.WAYPOST_HARNESS || null });
    }
  } catch { /* presence is advisory; a command must never fail because of it */ }
}

async function main() {
  // Resolved ONCE, here, where process.ppid genuinely is the shell or harness
  // that invoked the CLI — not inside a script bin/waypost spawns, whose parent
  // pid is bin/waypost itself and is different on every single invocation (G-1).
  // Every child this process spawns inherits it via `env: { ...process.env }`.
  if (!process.env.WAYPOST_SESSION_ID) process.env.WAYPOST_SESSION_ID = sessionId(process.argv);

  const argv = process.argv.slice(2);
  // --project is recognised ONLY in the leading position, before the command
  // name — not anywhere in argv, or a positional argument that happens to
  // equal it (a search term, say) would be swallowed as a global flag (A-8).
  let i = 0;
  while (i < argv.length) {
    if (argv[i] === "--project" && argv[i + 1] !== undefined) {
      process.env.WAYPOST_PROJECT_DIR = resolve(expandHome(argv[i + 1]));
      i += 2;
    } else break;
  }
  const args = argv.slice(i);
  const [cmd = "", ...rest] = args;
  await heartbeat(cmd);

  switch (cmd) {
    case "": handleDefault(); break;
    case "setup": handleSetup(rest); break;
    case "next": handleNext(rest); break;
    case "bind": case "init": handleBind(rest); break;
    case "scaffold": handleScaffold(rest); break;
    case "draft": handleDraft(rest); break;
    case "story": handleStory(rest); break;
    case "graph": {
      const forPath = opt(rest, "--for");
      if (forPath) handleGraphQuery(forPath, rest); else handleDerived("graph", rest);
      break;
    }
    case "kanban": case "codemap": handleDerived(cmd, rest); break;
    case "search": handleSearch(rest); break;
    case "reconcile": handleReconcile(rest); break;
    case "doctor": run("doctor", rest); break;
    case "diff-refs": run("diff-refs", rest); break;
    case "agents": run("agents", rest); break;
    case "harnesses": run("agents", ["harnesses", ...rest]); break;
    case "sessions": run("sessions", rest); break;
    case "brief": await selfInstall(rest); run("brief", rest.filter((a) => a !== "--no-install")); break;
    case "commit": run("commit", rest); break;
    case "merge": run("commit", ["--merge", ...rest]); break;
    case "log": run("commit", ["--log", ...rest]); break;
    case "merge-derived": run("merge-derived", rest); break;
    case "lease": run("presence", leaseArgs(rest)); break;
    case "storage": run("presence", ["storage"]); break;
    case "watch": run("presence", ["watch", ...rest]); break;
    case "tokens": run("tokens", rest); break;
    case "prompt": printDoc("prompts", positionals(rest)[0]); break;
    case "skill": printDoc("skills", positionals(rest)[0], "SKILL.md"); break;
    case "status": handleStatus(); break;
    case "version": case "--version": case "-v": process.stdout.write(`${VERSION}\n`); break;
    case "help": case "--help": case "-h": help(); break;
    default:
      process.stderr.write(`waypost: unknown command "${cmd}"\n\n`);
      help();
      process.exit(1);
  }
}

main().catch((e) => fail(e && e.message ? e.message : String(e)));
