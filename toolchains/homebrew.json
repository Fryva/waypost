{
  "id": "homebrew",
  "name": "Homebrew",
  "os": [
    "darwin",
    "linux"
  ],
  "detect": {
    "bins": [
      "brew"
    ],
    "manifests": []
  },
  "artifacts": [],
  "skip": [],
  "caches": [
    {
      "path": "$HOME/Library/Caches/Homebrew",
      "os": [
        "darwin"
      ],
      "confidence": {
        "darwin": "verified"
      },
      "docs": "https://docs.brew.sh/Manpage",
      "notes": "ask.env sets HOMEBREW_NO_AUTO_UPDATE=1 so being asked never triggers brew's own auto-update (https://docs.brew.sh/Manpage#environment).",
      "regenerable": true,
      "clean": "brew cleanup --prune=all",
      "ask": {
        "argv": ["brew", "--cache"],
        "parse": "line",
        "env": { "HOMEBREW_NO_AUTO_UPDATE": "1" },
        "docs": "https://docs.brew.sh/Manpage"
      }
    },
    {
      "path": "$XDG_CACHE_HOME/Homebrew",
      "os": [
        "linux"
      ],
      "confidence": {
        "linux": "documented"
      },
      "docs": "https://docs.brew.sh/Manpage",
      "notes": "ask.env sets HOMEBREW_NO_AUTO_UPDATE=1 so being asked never triggers brew's own auto-update (https://docs.brew.sh/Manpage#environment).",
      "regenerable": true,
      "clean": "brew cleanup --prune=all",
      "ask": {
        "argv": ["brew", "--cache"],
        "parse": "line",
        "env": { "HOMEBREW_NO_AUTO_UPDATE": "1" },
        "docs": "https://docs.brew.sh/Manpage"
      }
    }
  ],
  "locators": []
}
