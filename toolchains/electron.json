{
  "id": "electron",
  "name": "Electron",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "detect": {
    "bins": [],
    "manifests": []
  },
  "artifacts": [],
  "skip": [],
  "caches": [
    {
      "path": "$HOME/Library/Caches/electron",
      "os": [
        "darwin"
      ],
      "confidence": {
        "darwin": "inferred"
      },
      "notes": "Electron's build-download cache convention for macOS; not present on this machine.",
