      "clean": "rm -rf (will re-download)"
    },
    {
      "path": "$XDG_CACHE_HOME/electron",
      "os": [
        "linux"
      ],
      "confidence": {
        "linux": "inferred"
      },
      "notes": "Electron's build-download cache convention for Linux; not verifiable from macOS.",
      "regenerable": true,
      "clean": "rm -rf (will re-download)"
    },
    {
      "path": "$LOCALAPPDATA/electron/Cache",
      "os": [
        "win32"
      ],
      "confidence": {
        "win32": "inferred"
      },
      "notes": "Electron's build-download cache convention for Windows; not verifiable from macOS.",
      "regenerable": true,
      "clean": "rm -rf (will re-download)"
    }
  ],
  "locators": []
}
