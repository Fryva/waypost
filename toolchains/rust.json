{
  "id": "rust",
  "name": "Rust (Cargo, rustup)",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "detect": {
    "bins": [
      "cargo",
      "rustup"
    ],
    "manifests": [
      "Cargo.toml"
    ]
  },
  "artifacts": [],
  "skip": [],
  "caches": [
    {
      "path": "$HOME/.cargo/registry",
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "confidence": {
        "darwin": "verified",
        "linux": "documented",
        "win32": "documented"
      },
      "docs": "https://doc.rust-lang.org/cargo/guide/cargo-home.html",
      "regenerable": true,
      "clean": "cargo cache -a (cargo install cargo-cache) or rm -rf ~/.cargo/registry/{cache,src}"
    },
    {
      "path": "$HOME/.cargo/git",
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "confidence": {
        "darwin": "verified",
        "linux": "documented",
        "win32": "documented"
      },
      "docs": "https://doc.rust-lang.org/cargo/guide/cargo-home.html",
      "regenerable": true,
      "clean": "rm -rf ~/.cargo/git/checkouts"
    },
    {
      "path": "$HOME/.rustup/toolchains",
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "confidence": {
        "darwin": "verified",
        "linux": "documented",
        "win32": "documented"
      },
      "docs": "https://rust-lang.github.io/rustup/environment-variables.html",
      "regenerable": true,
      "clean": "rustup toolchain list; rustup toolchain uninstall <old-ones>"
    }
  ],
  "locators": []
}
