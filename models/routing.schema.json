{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Waypost routing manifest (proposal only; not collector evidence or a grant)",
 "type": "object",
 "required": ["protocol", "goal", "base", "domain", "task_class", "criteria_digest", "paths", "tools", "isolation", "input_tokens", "output_tokens", "attempts", "budget", "capability", "safety"],
 "properties": {
  "protocol": {"const": 1},
  "goal": {"type": "string", "minLength": 1, "maxLength": 8192},
  "base": {"type": "string", "minLength": 1, "maxLength": 256},
  "domain": {"type": "string", "minLength": 1, "maxLength": 256},
  "task_class": {"type": "string", "minLength": 1, "maxLength": 256},
  "criteria_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
  "paths": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
  "tools": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
  "isolation": {"enum": ["worktree", "read-only"]},
  "input_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000},
  "output_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000},
  "attempts": {"type": "integer", "minimum": 1, "maximum": 4},
  "budget": {"type": "object", "required": ["currency", "max_units", "reserved_control_units"], "properties": {"currency": {"type": "string", "minLength": 1, "maxLength": 16}, "max_units": {"$ref": "#/$defs/money"}, "reserved_control_units": {"$ref": "#/$defs/money"}}},
  "capability": {"type": "object", "required": ["benchmark", "revision", "criteria_digest", "min_passes"], "properties": {"benchmark": {"type": "string", "minLength": 1, "maxLength": 256}, "revision": {"type": "string", "minLength": 1, "maxLength": 256}, "criteria_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "min_passes": {"type": "integer", "minimum": 1, "maximum": 10000000}}},
  "safety": {"type": "object", "properties": {"bounded": {"type": "boolean"}, "reversible": {"type": "boolean"}, "architecture": {"type": "boolean"}, "security": {"type": "boolean"}, "migration": {"type": "boolean"}, "publication": {"type": "boolean"}, "data_loss": {"type": "boolean"}}}
 },
 "$defs": {"money": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,17})$"}}
}
